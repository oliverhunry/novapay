<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NovaPay - Deposit</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }
        body { background: #f0f4f8; min-height: 100vh; padding: 20px; }
        .container { max-width: 480px; margin: 0 auto; background: white; border-radius: 20px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px solid #eef2f6; }
        .header .logo { font-size: 20px; font-weight: 800; color: #0f172a; }
        .header .logo span { color: #3b82f6; }
        .header a { color: #3b82f6; text-decoration: none; font-size: 14px; }
        .header a:hover { color: #2563eb; text-decoration: underline; }
        .balance-box { background: linear-gradient(135deg, #1e293b, #0f172a); border-radius: 12px; padding: 15px 20px; margin-bottom: 20px; text-align: center; color: white; }
        .balance-box .label { font-size: 11px; color: #94a3b8; text-transform: uppercase; }
        .balance-box .amount { font-size: 24px; font-weight: 700; }
        .account-card {
            background: #f8fafc;
            border: 2px solid #3b82f6;
            border-radius: 12px;
            padding: 14px 16px;
            margin-bottom: 12px;
            border-left: 5px solid #3b82f6;
            transition: all 0.3s ease;
        }
        .account-card:hover {
            transform: translateX(5px);
            box-shadow: 0 4px 12px rgba(59,130,246,0.15);
        }
        .account-card .method { font-weight: 700; font-size: 14px; color: #0f172a; }
        .account-card .title { font-size: 13px; color: #475569; }
        .account-card .number { font-size: 16px; font-weight: 700; color: #3b82f6; margin-top: 4px; }
        .account-card .highlight { background: #dbeafe; padding: 2px 8px; border-radius: 4px; font-size: 10px; color: #1d4ed8; }
        .form-group { margin-bottom: 14px; }
        .form-group label { display: block; font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 4px; }
        .form-group label i { margin-right: 4px; color: #3b82f6; }
        .form-group input, .form-group select { 
            width: 100%; 
            padding: 10px 14px; 
            border: 1px solid #e2e8f0; 
            border-radius: 10px; 
            font-size: 14px; 
            transition: border-color 0.3s, box-shadow 0.3s;
        }
        .form-group input:focus, .form-group select:focus { 
            outline: none; 
            border-color: #3b82f6; 
            box-shadow: 0 0 0 3px rgba(59,130,246,0.1); 
        }
        .form-group input[type="file"] {
            padding: 8px 10px;
            background: #f8fafc;
            cursor: pointer;
        }
        .form-group input[type="file"]:hover {
            background: #f1f5f9;
        }
        .btn-submit { 
            width: 100%; 
            padding: 12px; 
            background: #3b82f6; 
            color: white; 
            border: none; 
            border-radius: 10px; 
            font-size: 16px; 
            font-weight: 600; 
            cursor: pointer; 
            transition: background 0.3s, transform 0.2s;
        }
        .btn-submit:hover { background: #2563eb; }
        .btn-submit:active { transform: scale(0.98); }
        .btn-submit:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none !important;
        }
        .flash-message { padding: 10px 14px; border-radius: 10px; margin-bottom: 12px; font-size: 13px; }
        .flash-success { background: #dcfce7; color: #166534; border: 1px solid #86efac; }
        .flash-error { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
        .info-text { font-size: 12px; color: #64748b; margin-top: 4px; }
        .info-text i { margin-right: 4px; }
        .min-amount { 
            background: #fef3c7; 
            padding: 8px 12px; 
            border-radius: 8px; 
            font-size: 12px; 
            color: #92400e; 
            margin-bottom: 16px; 
            text-align: center; 
        }
        .min-amount i { margin-right: 6px; color: #f59e0b; }
        .file-name-display {
            font-size: 12px;
            color: #3b82f6;
            margin-top: 4px;
            display: none;
        }
        .file-name-display.show {
            display: block;
        }
        .spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255,255,255,0.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spin 0.6s linear infinite;
            margin-right: 6px;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* ============================== */
        /* HISTORY TABLE */
        /* ============================== */
        .history-section {
            margin-top: 24px;
            padding-top: 16px;
            border-top: 1px solid #eef2f6;
        }
        .history-section h4 {
            color: #0f172a;
            font-size: 14px;
            margin-bottom: 10px;
        }
        .history-section h4 i {
            color: #3b82f6;
            margin-right: 6px;
        }
        .history-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }
        .history-table th {
            background: #f1f5f9;
            padding: 8px 6px;
            text-align: left;
            color: #475569;
            font-weight: 600;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }
        .history-table td {
            padding: 8px 6px;
            border-bottom: 1px solid #f1f5f9;
            color: #1e293b;
            font-size: 12px;
        }
        .history-table tr:last-child td {
            border-bottom: none;
        }
        .badge {
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 10px;
            font-weight: 600;
            display: inline-block;
        }
        .badge-pending { background: #fef3c7; color: #92400e; }
        .badge-approved { background: #dcfce7; color: #166534; }
        .badge-rejected { background: #fee2e2; color: #991b1b; }
        .no-data {
            text-align: center;
            color: #94a3b8;
            padding: 20px 10px;
            font-size: 13px;
        }
        .no-data i {
            font-size: 28px;
            display: block;
            margin-bottom: 6px;
            opacity: 0.5;
        }
        .view-all-link {
            text-align: center;
            margin-top: 8px;
            font-size: 12px;
        }
        .view-all-link a {
            color: #3b82f6;
            text-decoration: none;
            font-weight: 600;
        }
        .view-all-link a:hover {
            text-decoration: underline;
        }

        @media (max-width: 480px) {
            .container { padding: 16px; }
            .balance-box .amount { font-size: 20px; }
            .history-table th, .history-table td {
                font-size: 11px;
                padding: 6px 4px;
            }
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <div class="logo">💰 NOVA<span>PAY</span></div>
        <a href="/dashboard"><i class="fas fa-arrow-left"></i> Back</a>
    </div>

    <div class="balance-box">
        <div class="label">Your Balance</div>
        <div class="amount" id="depositBalance">PKR <%= (typeof user.balance !== 'undefined' && user.balance !== null) ? Number(user.balance).toFixed(2) : '0.00' %></div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="flash-message flash-success"><%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="flash-message flash-error"><%= error %></div>
    <% } %>

    <div class="min-amount">
        <i class="fas fa-info-circle"></i> Minimum deposit: PKR 1,300 (No decimals allowed)
    </div>

    <h4 style="margin-bottom:12px;color:#0f172a;">🏦 Admin Deposit Accounts</h4>
    
    <% if (typeof accounts !== 'undefined' && accounts && accounts.length > 0) { %>
        <% accounts.forEach(function(acc) { %>
            <div class="account-card">
                <div>
                    <span class="method"><%= acc.method %></span>
                    <span class="highlight"><i class="fas fa-check-circle"></i> Active</span>
                </div>
                <div class="title"><%= acc.account_title %></div>
                <div class="number"><%= acc.account_number %></div>
            </div>
        <% }); %>
    <% } else { %>
        <div style="background:#f8fafc;padding:12px;border-radius:10px;text-align:center;color:#94a3b8;margin-bottom:12px;">
            No accounts available. Contact admin.
        </div>
    <% } %>

    <h4 style="margin:16px 0 12px;color:#0f172a;">📤 Submit Deposit Request</h4>

    <form action="/deposit" method="POST" enctype="multipart/form-data" id="depositForm">
        <div class="form-group">
            <label><i class="fas fa-coins"></i> Amount (PKR)</label>
            <input type="number" name="amount" id="depositAmount" min="1300" step="1" placeholder="Enter amount" required>
            <div class="info-text"><i class="fas fa-info-circle"></i> Minimum: PKR 1,300 (No decimals)</div>
        </div>
        
        <div class="form-group">
            <label><i class="fas fa-image"></i> Payment Screenshot / Slip</label>
            <input type="file" name="slip" id="slipInput" accept="image/*" required>
            <div class="info-text"><i class="fas fa-info-circle"></i> Upload payment proof (PNG, JPG, JPEG)</div>
            <div class="file-name-display" id="fileNameDisplay">
                <i class="fas fa-check-circle" style="color:#22c55e;"></i> Selected: <span id="fileName"></span>
            </div>
        </div>

        <button type="submit" class="btn-submit" id="depositBtn">
            <i class="fas fa-upload"></i> Submit Deposit
        </button>
    </form>

    <!-- ============================== -->
    <!-- DEPOSIT HISTORY -->
    <!-- ============================== -->
    <div class="history-section">
        <h4><i class="fas fa-clock-rotate-left"></i> Deposit History</h4>
        
        <% if (typeof depositHistory !== 'undefined' && depositHistory && depositHistory.length > 0) { %>
            <table class="history-table">
                <thead>
                    <tr>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    <% depositHistory.slice(0, 5).forEach(function(d) { %>
                        <tr>
                            <td><strong>PKR <%= Number(d.amount).toFixed(2) %></strong></td>
                            <td><%= d.payment_method || 'N/A' %></td>
                            <td>
                                <span class="badge badge-<%= d.status || 'pending' %>">
                                    <%= d.status || 'pending' %>
                                </span>
                            </td>
                            <td><%= new Date(d.created_at).toLocaleDateString('en-PK', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
            <% if (depositHistory.length > 5) { %>
                <div class="view-all-link">
                    <a href="/records">View All (<%= depositHistory.length %> entries) →</a>
                </div>
            <% } %>
        <% } else { %>
            <div class="no-data">
                <i class="fas fa-history"></i>
                No deposit history found
            </div>
        <% } %>
    </div>

</div>

<script>
    (function() {
        'use strict';

        const depositForm = document.getElementById('depositForm');
        const depositBtn = document.getElementById('depositBtn');
        const depositAmount = document.getElementById('depositAmount');
        const slipInput = document.getElementById('slipInput');
        const fileNameDisplay = document.getElementById('fileNameDisplay');
        const fileName = document.getElementById('fileName');
        const MIN_DEPOSIT = 1300;

        // File name display
        slipInput.addEventListener('change', function() {
            if (this.files && this.files.length > 0) {
                const file = this.files[0];
                const validTypes = ['image/png', 'image/jpg', 'image/jpeg', 'image/gif', 'image/webp'];
                if (!validTypes.includes(file.type)) {
                    alert('Please upload a valid image file (PNG, JPG, JPEG, GIF, WEBP)');
                    this.value = '';
                    fileNameDisplay.classList.remove('show');
                    return;
                }
                
                if (file.size > 5 * 1024 * 1024) {
                    alert('File size must be less than 5MB');
                    this.value = '';
                    fileNameDisplay.classList.remove('show');
                    return;
                }

                fileName.textContent = file.name;
                fileNameDisplay.classList.add('show');
            } else {
                fileNameDisplay.classList.remove('show');
            }
        });

        // Prevent decimal input (dot aur comma block karo)
        depositAmount.addEventListener('keydown', function(e) {
            if (e.key === '.' || e.key === ',') {
                e.preventDefault();
            }
        });

        // On blur - remove decimals
        depositAmount.addEventListener('blur', function() {
            const value = parseFloat(this.value);
            if (value && !isNaN(value)) {
                // Remove decimals (round to whole number)
                const rounded = Math.round(value);
                this.value = rounded;
                
                if (rounded < MIN_DEPOSIT) {
                    alert('Minimum deposit amount is PKR ' + MIN_DEPOSIT.toLocaleString());
                    this.value = '';
                }
            }
        });

        // Form validation - sirf minimum aur decimals check
        depositForm.addEventListener('submit', function(e) {
            const amount = parseFloat(depositAmount.value);
            const file = slipInput.files[0];

            if (!amount || isNaN(amount)) {
                e.preventDefault();
                alert('Please enter a valid amount');
                depositAmount.focus();
                return;
            }

            if (amount < MIN_DEPOSIT) {
                e.preventDefault();
                alert('Minimum deposit amount is PKR ' + MIN_DEPOSIT.toLocaleString());
                depositAmount.focus();
                return;
            }

            // Check for decimals
            if (amount % 1 !== 0) {
                e.preventDefault();
                alert('Amount must be a whole number (no decimals)');
                depositAmount.value = Math.round(amount);
                depositAmount.focus();
                return;
            }

            if (!file) {
                e.preventDefault();
                alert('Please upload a payment screenshot or slip');
                slipInput.focus();
                return;
            }

            if (!confirm(`Are you sure you want to deposit PKR ${amount.toFixed(2)}?`)) {
                e.preventDefault();
                return;
            }

            depositBtn.disabled = true;
            depositBtn.innerHTML = '<span class="spinner"></span> Submitting...';
        });

        window.addEventListener('pageshow', function() {
            depositBtn.disabled = false;
            depositBtn.innerHTML = '<i class="fas fa-upload"></i> Submit Deposit';
        });

        // Copy account details on click
        document.querySelectorAll('.account-card .number').forEach(function(element) {
            element.style.cursor = 'pointer';
            element.addEventListener('click', function() {
                const text = this.textContent.trim();
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(text).then(function() {
                        const originalText = element.textContent;
                        element.textContent = '✅ Copied!';
                        element.style.color = '#22c55e';
                        setTimeout(function() {
                            element.textContent = originalText;
                            element.style.color = '#3b82f6';
                        }, 2000);
                    }).catch(function() {
                        alert('Failed to copy. Please select the number manually.');
                    });
                } else {
                    const textArea = document.createElement('textarea');
                    textArea.value = text;
                    document.body.appendChild(textArea);
                    textArea.select();
                    try {
                        document.execCommand('copy');
                        const originalText = element.textContent;
                        element.textContent = '✅ Copied!';
                        element.style.color = '#22c55e';
                        setTimeout(function() {
                            element.textContent = originalText;
                            element.style.color = '#3b82f6';
                        }, 2000);
                    } catch (err) {
                        alert('Failed to copy. Please select the number manually.');
                    }
                    document.body.removeChild(textArea);
                }
            });
        });

    })();
</script>

</body>
</html>