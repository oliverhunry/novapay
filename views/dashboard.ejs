<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>NovaPay - Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }
        body { background: #f0f4f8; color: #1a2332; min-height: 100vh; padding: 10px; }
        .app-container { max-width: 480px; margin: 0 auto; background: #ffffff; border-radius: 20px; padding: 16px 14px 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; padding-bottom: 10px; border-bottom: 1px solid #eef2f6; }
        .header .logo { font-size: 20px; font-weight: 800; color: #0f172a; }
        .header .logo span { color: #3b82f6; }
        .header .logo small { display: block; font-size: 9px; font-weight: 400; color: #94a3b8; letter-spacing: 2px; }
        .header .badge { background: #22c55e; color: #fff; font-size: 9px; font-weight: 700; padding: 4px 12px; border-radius: 20px; }
        .header .menu-btn { background: #f8fafc; border: 1px solid #eef2f6; border-radius: 10px; padding: 6px 10px; font-size: 20px; cursor: pointer; color: #0f172a; }
        
        .whatsapp-top { background: #25D366; border-radius: 10px; padding: 8px 14px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center; color: white; text-decoration: none; }
        .whatsapp-top i { font-size: 20px; }
        .whatsapp-top .text { font-size: 13px; font-weight: 500; }
        .whatsapp-top .btn { background: rgba(255,255,255,0.2); padding: 3px 12px; border-radius: 6px; font-size: 11px; }
        
        .user-info { background: #f8fafc; padding: 10px 16px; border-radius: 14px; margin-bottom: 14px; border: 1px solid #eef2f6; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; }
        .user-info .name { font-size: 14px; font-weight: 600; color: #0f172a; }
        .user-info .name small { font-size: 10px; font-weight: 400; color: #94a3b8; display: block; }
        .user-info .vip-tag { background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; font-size: 9px; font-weight: 700; padding: 3px 12px; border-radius: 20px; }
        
        .today-earnings { background: linear-gradient(135deg, #22c55e, #16a34a); border-radius: 12px; padding: 12px 16px; margin-bottom: 14px; display: flex; justify-content: space-between; align-items: center; color: white; }
        .today-earnings .label { font-size: 12px; opacity: 0.9; }
        .today-earnings .value { font-size: 20px; font-weight: 700; }
        
        .balance-card { background: linear-gradient(135deg, #1e293b, #0f172a); border-radius: 16px; padding: 18px 20px; margin-bottom: 16px; text-align: center; position: relative; }
        .balance-card .label { font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; }
        .balance-card .amount { font-size: 32px; font-weight: 700; color: #ffffff; margin: 4px 0 2px; }
        .balance-card .amount small { font-size: 14px; font-weight: 400; color: #94a3b8; }
        .balance-card .sub { font-size: 10px; color: #64748b; }
        .refresh-btn { position: absolute; top: 10px; right: 15px; background: rgba(255,255,255,0.1); border: none; color: #94a3b8; cursor: pointer; font-size: 16px; padding: 4px 8px; border-radius: 6px; transition: 0.3s; }
        .refresh-btn:hover { background: rgba(255,255,255,0.2); color: white; }
        .refresh-btn.spinning { animation: spin 0.6s linear; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        
        .action-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; margin-bottom: 18px; }
        .action-btn { background: #f8fafc; border: 1px solid #eef2f6; border-radius: 12px; padding: 10px 4px; text-align: center; text-decoration: none; color: #1a2332; transition: 0.3s; cursor: pointer; }
        .action-btn:hover { border-color: #3b82f6; background: #f0f4ff; transform: translateY(-2px); }
        .action-btn .icon { font-size: 20px; display: block; margin-bottom: 2px; }
        .action-btn .label { font-size: 9px; font-weight: 500; color: #475569; }
        
        .section-title { font-size: 14px; font-weight: 600; color: #0f172a; margin: 16px 0 10px; }
        .section-title small { font-size: 10px; font-weight: 400; color: #94a3b8; display: block; }
        
        .active-plan { background: #f8fafc; border: 1px solid #eef2f6; border-radius: 10px; padding: 10px 14px; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; }
        .active-plan .plan-info .name { font-weight: 600; font-size: 13px; color: #0f172a; }
        .active-plan .plan-info .daily { font-size: 11px; color: #64748b; }
        .active-plan .status-badge { background: #22c55e; color: white; font-size: 9px; padding: 2px 10px; border-radius: 12px; }
        
        /* Plans Line by Line */
        .plan-line {
            background: #f8fafc;
            border: 1px solid #eef2f6;
            border-radius: 10px;
            padding: 12px 14px;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: 0.3s;
        }
        .plan-line:hover { border-color: #3b82f6; }
        .plan-line .plan-info .name { font-weight: 700; font-size: 14px; color: #0f172a; }
        .plan-line .plan-info .name .vip-badge { background: linear-gradient(135deg, #f59e0b, #d97706); color: white; font-size: 8px; padding: 1px 8px; border-radius: 10px; margin-left: 6px; }
        .plan-line .plan-info .details { font-size: 12px; color: #64748b; margin-top: 2px; }
        .plan-line .plan-info .details .price { color: #3b82f6; font-weight: 600; }
        .plan-line .plan-info .details .daily { color: #22c55e; font-weight: 600; }
        .plan-line .plan-btn { background: #3b82f6; border: none; color: #fff; padding: 4px 16px; border-radius: 16px; font-size: 11px; font-weight: 600; cursor: pointer; transition: 0.3s; }
        .plan-line .plan-btn:hover { background: #2563eb; transform: scale(1.05); }
        
        .summary-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 16px; }
        .summary-item { background: #f8fafc; border: 1px solid #eef2f6; border-radius: 10px; padding: 10px 4px; text-align: center; }
        .summary-item .icon { font-size: 16px; display: block; margin-bottom: 2px; }
        .summary-item .label { font-size: 8px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.3px; }
        .summary-item .value { font-size: 12px; font-weight: 700; color: #0f172a; margin-top: 1px; }
        .summary-item .value.green { color: #22c55e; }
        .summary-item .value.blue { color: #3b82f6; }
        .summary-item .value.gold { color: #f59e0b; }
        .summary-item .value.purple { color: #8b5cf6; }
        
        .referral-box { background: #f8fafc; border: 1px solid #eef2f6; border-radius: 12px; padding: 10px 14px; margin-bottom: 10px; }
        .referral-box .label { font-size: 9px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; }
        .referral-box .link { color: #3b82f6; word-break: break-all; font-size: 11px; margin-top: 2px; }
        .referral-box .stats { margin-top: 6px; display: flex; gap: 12px; font-size: 11px; color: #64748b; }
        
        .whatsapp-box { background: #25D366; border-radius: 12px; padding: 12px 16px; display: flex; align-items: center; gap: 12px; color: white; text-decoration: none; }
        .whatsapp-box i { font-size: 28px; }
        .whatsapp-box .info .title { font-weight: 600; font-size: 14px; }
        .whatsapp-box .info .sub { font-size: 11px; opacity: 0.9; }
        .whatsapp-box .btn { margin-left: auto; background: rgba(255,255,255,0.2); color: white; padding: 4px 14px; border-radius: 6px; text-decoration: none; font-weight: 500; font-size: 11px; border: none; cursor: pointer; }
        .whatsapp-box .btn:hover { background: rgba(255,255,255,0.3); }
        
        .flash-message { padding: 10px 14px; border-radius: 10px; margin-bottom: 12px; font-size: 13px; }
        .flash-success { background: #dcfce7; color: #166534; border: 1px solid #86efac; }
        .flash-error { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
        
        .sidebar-left { position: fixed; left: -280px; top: 0; width: 270px; height: 100vh; background: #ffffff; box-shadow: 4px 0 30px rgba(0,0,0,0.1); transition: 0.4s ease; padding: 20px 16px; overflow-y: auto; z-index: 1000; border-right: 1px solid #eef2f6; }
        .sidebar-left.open { left: 0; }
        .sidebar-left .close-btn { background: none; border: none; font-size: 24px; color: #94a3b8; cursor: pointer; float: right; padding: 4px; }
        .sidebar-left .sidebar-logo { font-size: 18px; font-weight: 800; color: #0f172a; margin: 30px 0 6px; }
        .sidebar-left .sidebar-logo span { color: #3b82f6; }
        .sidebar-left .sidebar-logo small { display: block; font-size: 9px; font-weight: 400; color: #94a3b8; letter-spacing: 2px; }
        .sidebar-left .sidebar-title { font-size: 13px; font-weight: 600; color: #0f172a; margin: 18px 0 10px; padding-bottom: 6px; border-bottom: 1px solid #eef2f6; }
        .sidebar-left .sidebar-title small { font-size: 10px; font-weight: 400; color: #94a3b8; display: block; }
        .sidebar-left .qa-item { display: flex; align-items: center; gap: 14px; padding: 11px 14px; border-radius: 10px; color: #475569; text-decoration: none; transition: 0.3s; margin-bottom: 2px; font-size: 14px; cursor: pointer; border: none; background: none; width: 100%; text-align: left; }
        .sidebar-left .qa-item:hover { background: #f1f5f9; color: #0f172a; }
        .sidebar-left .qa-item .icon { font-size: 18px; width: 26px; text-align: center; }
        .sidebar-left .qa-divider { border-top: 1px solid #eef2f6; margin: 10px 0; }
        .sidebar-left .badge-count { background: #ef4444; color: white; font-size: 9px; padding: 1px 6px; border-radius: 10px; margin-left: auto; }
        .overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.3); z-index: 999; display: none; }
        .overlay.show { display: block; }
        
        @media (max-width: 420px) { .app-container { padding: 12px 10px; border-radius: 16px; } .balance-card .amount { font-size: 26px; } .summary-grid { grid-template-columns: repeat(2, 1fr); } .action-grid { gap: 4px; } .action-btn { padding: 8px 2px; } .action-btn .icon { font-size: 16px; } .action-btn .label { font-size: 8px; } .sidebar-left { width: 230px; left: -240px; } }
        @media (min-width: 600px) { .app-container { max-width: 560px; padding: 24px 28px; } }
    </style>
</head>
<body>

<div class="overlay" id="overlay" onclick="closeSidebar()"></div>

<div class="sidebar-left" id="leftSidebar">
    <button class="close-btn" onclick="closeSidebar()">✕</button>
    <div class="sidebar-logo">NOVA<span>PAY</span><small>✦ INTERNATIONAL</small></div>
    <div class="sidebar-title">Quick Access<small>SERVICES</small></div>
    <a href="/dashboard" class="qa-item" onclick="closeSidebar();"><span class="icon">📊</span> Dashboard</a>
    <a href="/deposit" class="qa-item" onclick="closeSidebar();"><span class="icon">💰</span> Deposit</a>
    <a href="/mining" class="qa-item" onclick="closeSidebar();"><span class="icon">⛏️</span> Mining</a>
    <a href="/withdraw" class="qa-item" onclick="closeSidebar();"><span class="icon">💸</span> Withdraw</a>
    <a href="/team" class="qa-item" onclick="closeSidebar();"><span class="icon">👥</span> Team</a>
    <a href="/bonus" class="qa-item" onclick="closeSidebar();"><span class="icon">🎁</span> Bonus</a>
    <a href="/notifications" class="qa-item" onclick="closeSidebar();"><span class="icon">🔔</span> Notifications
        <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
            <span class="badge-count"><%= unreadCount %></span>
        <% } %>
    </a>
    <a href="/records" class="qa-item" onclick="closeSidebar();"><span class="icon">📊</span> Records</a>
    <a href="/support" class="qa-item" onclick="closeSidebar();"><span class="icon">🛡️</span> Support</a>
    <div class="qa-divider"></div>
    <a href="/logout" class="qa-item" style="color:#ef4444;"><span class="icon">🚪</span> Logout</a>
</div>

<div class="app-container">

    <div class="header">
        <div style="display:flex;align-items:center;gap:6px;">
            <button class="menu-btn" onclick="openSidebar()">☰</button>
            <div class="logo">NOVA<span>PAY</span><small>✦ INTERNATIONAL</small></div>
        </div>
        <span class="badge">● LIVE</span>
    </div>

    <a href="https://whatsapp.com/channel/novapay" target="_blank" class="whatsapp-top">
        <div style="display:flex;align-items:center;gap:8px;">
            <i class="fab fa-whatsapp"></i>
            <span class="text">Join WhatsApp Channel</span>
        </div>
        <span class="btn">Follow</span>
    </a>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="flash-message flash-success"><%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="flash-message flash-error"><%= error %></div>
    <% } %>

    <div class="user-info">
        <div class="name">👋 Welcome, <%= user.username %><small>TRUSTED PLATFORM</small></div>
        <span class="vip-tag">👑 VIP ELITE</span>
    </div>

    <div class="today-earnings">
        <div>
            <div class="label">📈 Today's Earnings</div>
            <div class="value">PKR <%= typeof todayEarnings !== 'undefined' ? todayEarnings.toFixed(2) : '0.00' %></div>
        </div>
        <div style="font-size:12px;opacity:0.8;">
            <i class="fas fa-clock"></i> Daily
        </div>
    </div>

    <div class="balance-card">
        <button class="refresh-btn" onclick="refreshBalance()" id="refreshBtn">
            <i class="fas fa-sync-alt"></i>
        </button>
        <div class="label">💰 Available Balance</div>
        <div class="amount" id="liveBalance">PKR <%= user.balance ? user.balance.toFixed(2) : '0.00' %></div>
        <div class="sub">Live Balance</div>
    </div>

    <!-- Action Grid with 5 Buttons (Deposit, Withdraw, Mining, Team, Bonus) -->
    <div class="action-grid">
        <a href="/deposit" class="action-btn">
            <span class="icon">💰</span>
            <span class="label">Deposit</span>
        </a>
        <a href="/withdraw" class="action-btn">
            <span class="icon">💸</span>
            <span class="label">Withdraw</span>
        </a>
        <a href="/mining" class="action-btn">
            <span class="icon">⛏️</span>
            <span class="label">Mining</span>
        </a>
        <a href="/team" class="action-btn">
            <span class="icon">👥</span>
            <span class="label">Team</span>
        </a>
        <a href="/bonus" class="action-btn">
            <span class="icon">🎁</span>
            <span class="label">Bonus</span>
        </a>
    </div>

    <!-- Active Plans Section -->
    <div class="section-title">
        Active Plans
        <small>YOUR CURRENT INVESTMENTS</small>
    </div>
    <% if (typeof userPlans !== 'undefined' && userPlans && userPlans.length > 0) { %>
        <% userPlans.forEach(function(plan) { %>
            <div class="active-plan">
                <div class="plan-info">
                    <div class="name"><%= plan.plan_name %></div>
                    <div class="daily">Daily: PKR <%= plan.daily_income %></div>
                </div>
                <span class="status-badge"><i class="fas fa-check-circle"></i> Active</span>
            </div>
        <% }); %>
    <% } else { %>
        <p style="color:#94a3b8;text-align:center;padding:10px;font-size:13px;">No active plans. Purchase a plan to start earning!</p>
    <% } %>

        <!-- Investment Plans - Bara + Highlight -->
    <div class="section-title">
        Investment Plans
        <small>CHOOSE YOUR PLAN</small>
    </div>
    
    <style>
        .plan-line {
            background: #f8fafc;
            border: 1px solid #eef2f6;
            border-radius: 14px;
            padding: 16px 18px;
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
            position: relative;
        }
        .plan-line:hover {
            border-color: #3b82f6;
            transform: translateX(5px);
            box-shadow: 0 4px 16px rgba(59,130,246,0.15);
        }
        .plan-line .plan-info .name {
            font-weight: 700;
            font-size: 18px;
            color: #0f172a;
        }
        .plan-line .plan-info .name .vip-badge {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
            font-size: 10px;
            padding: 2px 12px;
            border-radius: 12px;
            margin-left: 8px;
            display: inline-block;
        }
        .plan-line .plan-info .name .premium-badge {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
            color: white;
            font-size: 10px;
            padding: 2px 12px;
            border-radius: 12px;
            margin-left: 6px;
            display: inline-block;
        }
        .plan-line .plan-info .details {
            font-size: 14px;
            color: #475569;
            margin-top: 6px;
        }
        .plan-line .plan-info .details .price {
            color: #3b82f6;
            font-weight: 700;
            font-size: 15px;
        }
        .plan-line .plan-info .details .daily {
            color: #22c55e;
            font-weight: 700;
            font-size: 16px;
            background: #dcfce7;
            padding: 3px 14px;
            border-radius: 20px;
            display: inline-block;
        }
        .plan-line .plan-info .details .daily i {
            color: #22c55e;
        }
        .plan-line .plan-btn {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            border: none;
            color: #fff;
            padding: 10px 28px;
            border-radius: 25px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            white-space: nowrap;
            box-shadow: 0 2px 8px rgba(59,130,246,0.25);
        }
        .plan-line .plan-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 20px rgba(59,130,246,0.4);
        }
        .plan-line .plan-btn:active {
            transform: scale(0.95);
        }
        .plan-line .plan-return {
            font-size: 13px;
            color: #f59e0b;
            font-weight: 600;
            margin-top: 2px;
        }
        .plan-line .plan-return span {
            background: #fef3c7;
            padding: 2px 10px;
            border-radius: 12px;
        }
        @media (max-width: 480px) {
            .plan-line {
                flex-direction: column;
                align-items: stretch;
                gap: 10px;
                padding: 14px 16px;
            }
            .plan-line .plan-btn {
                width: 100%;
                text-align: center;
                padding: 12px;
            }
            .plan-line .plan-info .name {
                font-size: 16px;
            }
            .plan-line .plan-info .details {
                font-size: 13px;
            }
        }
    </style>

    <% if (typeof allPlans !== 'undefined' && allPlans && allPlans.length > 0) { %>
        <% allPlans.forEach(function(plan, index) { 
            var returnPercent = ((plan.daily_income / plan.investment) * 100).toFixed(0);
        %>
            <div class="plan-line">
                <div class="plan-info">
                    <div class="name">
                        <%= plan.name %>
                        <% if (index === 0) { %>
                            <span class="vip-badge"><i class="fas fa-crown"></i> VIP</span>
                        <% } %>
                        <% if (plan.investment >= 50000) { %>
                            <span class="premium-badge"><i class="fas fa-star"></i> PREMIUM</span>
                        <% } %>
                        <div class="plan-return"><span>🔥 <%= returnPercent %>% Daily Return</span></div>
                    </div>
                    <div class="details">
                        <span class="price">💰 PKR <%= plan.investment.toLocaleString() %></span>
                        &nbsp;|&nbsp;
                        <span class="daily"><i class="fas fa-arrow-up"></i> +PKR <%= plan.daily_income.toLocaleString() %> / day</span>
                    </div>
                </div>
                <button class="plan-btn" onclick="buyPlan(<%= plan.id %>, <%= plan.investment %>, '<%= plan.name %>')">
                    <i class="fas fa-shopping-cart"></i> Buy Now
                </button>
            </div>
        <% }); %>
    <% } else { %>
        <div style="text-align:center;padding:30px 20px;color:#94a3b8;background:#f8fafc;border-radius:12px;border:1px dashed #eef2f6;">
            <i class="fas fa-box-open" style="font-size:32px;display:block;margin-bottom:8px;"></i>
            <p>No plans available. Please check back later.</p>
        </div>
    <% } %>

    <!-- Account Summary -->
    <div class="section-title">
        Account Summary
        <small>YOUR FINANCIAL OVERVIEW</small>
    </div>
    <div class="summary-grid">
        <div class="summary-item">
            <span class="icon">📥</span>
            <div class="label">Total Deposit</div>
            <div class="value green">PKR <%= user.total_deposit ? user.total_deposit.toFixed(2) : '0.00' %></div>
        </div>
        <div class="summary-item">
            <span class="icon">📤</span>
            <div class="label">Total Withdraw</div>
            <div class="value blue">PKR <%= user.total_withdraw ? user.total_withdraw.toFixed(2) : '0.00' %></div>
        </div>
        <div class="summary-item">
            <span class="icon">📈</span>
            <div class="label">Total Earnings</div>
            <div class="value gold">PKR <%= user.total_earnings ? user.total_earnings.toFixed(2) : '0.00' %></div>
        </div>
        <div class="summary-item">
            <span class="icon">👥</span>
            <div class="label">Team Earnings</div>
            <div class="value purple">PKR <%= user.team_earnings ? user.team_earnings.toFixed(2) : '0.00' %></div>
        </div>
    </div>

    <div class="referral-box">
        <div class="label">🔗 Your Referral Link</div>
        <div class="link">http://localhost:3000/register?ref=<%= user.referral_code %></div>
        <div class="stats">
            <span>👥 Referrals: <%= typeof referralCount !== 'undefined' ? referralCount : 0 %></span>
            <span>💰 Commission: 10%</span>
        </div>
    </div>

    <a href="https://wa.me/923001234567" target="_blank" class="whatsapp-box">
        <i class="fab fa-whatsapp"></i>
        <div class="info">
            <div class="title">Contact on WhatsApp</div>
            <div class="sub">24/7 Support Available</div>
        </div>
        <span class="btn">Chat Now</span>
    </a>

</div>

<script>
    function openSidebar() {
        document.getElementById('leftSidebar').classList.add('open');
        document.getElementById('overlay').classList.add('show');
        document.body.style.overflow = 'hidden';
    }
    function closeSidebar() {
        document.getElementById('leftSidebar').classList.remove('open');
        document.getElementById('overlay').classList.remove('show');
        document.body.style.overflow = 'auto';
    }
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeSidebar(); });

    function buyPlan(planId, investment, name) {
        if (confirm(`Purchase ${name} plan for PKR ${investment}?`)) {
            fetch('/plan/buy', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ plan_id: planId })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(err => alert('Request failed'));
        }
    }

    function refreshBalance() {
        const btn = document.getElementById('refreshBtn');
        btn.classList.add('spinning');
        
        fetch('/api/balance')
            .then(res => res.json())
            .then(data => {
                if (data.success && data.data) {
                    document.getElementById('liveBalance').textContent = 'PKR ' + data.data.balance.toFixed(2);
                }
                btn.classList.remove('spinning');
            })
            .catch(err => {
                btn.classList.remove('spinning');
                alert('Failed to refresh balance');
            });
    }
</script>

</body>
</html>