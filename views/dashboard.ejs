    <a href="/logout" class="qa-item" style="color:#ef4444;"><span class="icon">🚪</span> Logout</a>
</div>

<div class="app-container">

    <div class="header">
        <div style="display:flex;align-items:center;gap:6px;">
            <button class="menu-btn" onclick="openSidebar()">☰</button>
            <div class="logo">NOVA<span>PAY</span><small>✦ INTERNATIONAL</small></div>
        </div>
        <span class="badge">● LIVE</span>
    </div>

    <a href="https://whatsapp.com/channel/novapay" target="_blank" class="whatsapp-top">
        <div style="display:flex;align-items:center;gap:8px;">
            <i class="fab fa-whatsapp"></i>
            <span class="text">Join WhatsApp Channel</span>
        </div>
        <span class="btn">Follow</span>
    </a>

    <!-- ============================== -->
    <!-- NEON GLOW LIVE UPDATES -->
    <!-- ============================== -->
    <div class="glow-wrap">
        <div class="glow-header">
            <div class="title">
                <span class="star">✦</span> LIVE <span class="star">✦</span>
            </div>
            <span class="count-badge" id="liveCount">0 updates</span>
        </div>
        <div class="glow-items">
            <div class="glow-items-scroll" id="liveGlowItems">
                <!-- JavaScript se data aayega -->
            </div>
        </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="flash-message flash-success"><%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="flash-message flash-error"><%= error %></div>
    <% } %>

    <div class="user-info">
        <div class="name">👋 Welcome, <%= user.username %><small>TRUSTED PLATFORM</small></div>
        <span class="vip-tag">👑 VIP ELITE</span>
    </div>

    <div class="today-earnings">
        <div>
            <div class="label">📈 Today's Earnings</div>
            <div class="value">PKR <%= (typeof todayEarnings !== 'undefined' && todayEarnings !== null) ? Number(todayEarnings).toFixed(2) : '0.00' %></div>
        </div>
        <div style="font-size:12px;opacity:0.8;">
            <i class="fas fa-clock"></i> Daily
        </div>
    </div>

    <div class="balance-card">
        <button class="refresh-btn" onclick="refreshBalance()" id="refreshBtn">
            <i class="fas fa-sync-alt"></i>
        </button>
        <div class="label">AVAILABLE BALANCE</div>
        <div class="amount" id="liveBalance">PKR <%= (typeof user.balance !== 'undefined' && user.balance !== null) ? Number(user.balance).toFixed(2) : '0.00' %></div>
        <div class="sub">Live Balance</div>
    </div>

    <div class="action-grid">
        <a href="/deposit" class="action-btn">
            <span class="icon">💰</span>
            <span class="label">Deposit</span>
        </a>
        <a href="/withdraw" class="action-btn">
            <span class="icon">💸</span>
            <span class="label">Withdraw</span>
        </a>
        <a href="/mining" class="action-btn">
            <span class="icon">⛏️</span>
            <span class="label">Mining</span>
        </a>
        <a href="/team" class="action-btn">
            <span class="icon">👥</span>
            <span class="label">Team</span>
        </a>
        <a href="/bonus" class="action-btn">
            <span class="icon">🎁</span>
            <span class="label">Bonus</span>
        </a>
    </div>

    <div class="section-title">
        Active Plans
        <small>YOUR CURRENT INVESTMENTS</small>
    </div>
    <% if (typeof userPlans !== 'undefined' && userPlans && userPlans.length > 0) { %>
        <% userPlans.forEach(function(plan) { %>
            <div class="active-plan">
                <div class="plan-info">
                    <div class="name"><%= plan.plan_name %></div>
                    <div class="daily">Daily: PKR <%= (typeof plan.daily_income !== 'undefined' && plan.daily_income !== null) ? Number(plan.daily_income).toFixed(2) : '0.00' %></div>
                </div>
                <span class="status-badge"><i class="fas fa-check-circle"></i> Active</span>
            </div>
        <% }); %>
    <% } else { %>
        <p style="color:#94a3b8;text-align:center;padding:10px;font-size:13px;">No active plans. Purchase a plan to start earning!</p>
    <% } %>

    <div class="section-title">
        Investment Plans
        <small>CHOOSE YOUR PLAN</small>
    </div>

    <% if (typeof allPlans !== 'undefined' && allPlans && allPlans.length > 0) { %>
        <% allPlans.forEach(function(plan, index) { 
            var returnPercent = ((Number(plan.daily_income) / Number(plan.investment)) * 100).toFixed(0);
        %>
            <div class="plan-line" id="plan-<%= plan.id %>">
                <div class="plan-info">
                    <div class="name">
                        <%= plan.name %>
                        <% if (index === 0) { %>
                            <span class="vip-badge"><i class="fas fa-crown"></i> VIP</span>
                        <% } %>
                        <div class="plan-return"><span>🔥 <%= returnPercent %>% Daily Return</span></div>
                    </div>
                    <div class="details">
                        <span class="price">💰 PKR <%= Number(plan.investment).toLocaleString() %></span>
                        &nbsp;|&nbsp;
                        <span class="daily"><i class="fas fa-arrow-up"></i> +PKR <%= Number(plan.daily_income).toLocaleString() %> / day</span>
                    </div>
                </div>
                <button class="plan-btn" onclick="buyPlan(<%= plan.id %>, <%= Number(plan.investment) %>, '<%= plan.name.replace(/'/g, "\\'") %>', this)">
                    <i class="fas fa-shopping-cart"></i> Buy Now
                </button>
            </div>
        <% }); %>
    <% } else { %>
        <div style="text-align:center;padding:30px 20px;color:#94a3b8;background:#f8fafc;border-radius:12px;border:1px dashed #eef2f6;">
            <i class="fas fa-box-open" style="font-size:32px;display:block;margin-bottom:8px;"></i>
            <p>No plans available. Please check back later.</p>
        </div>
    <% } %>

    <div class="section-title">
        Account Summary
        <small>YOUR FINANCIAL OVERVIEW</small>
    </div>
    <div class="summary-grid">
        <div class="summary-item">
            <span class="icon">📥</span>
            <div class="label">Total Deposit</div>
            <div class="value green">PKR <%= (typeof user.total_deposit !== 'undefined' && user.total_deposit !== null) ? Number(user.total_deposit).toFixed(2) : '0.00' %></div>
        </div>
        <div class="summary-item">
            <span class="icon">📤</span>
            <div class="label">Total Withdraw</div>
            <div class="value blue">PKR <%= (typeof user.total_withdraw !== 'undefined' && user.total_withdraw !== null) ? Number(user.total_withdraw).toFixed(2) : '0.00' %></div>
        </div>
        <div class="summary-item">
            <span class="icon">📈</span>
            <div class="label">Total Earnings</div>
            <div class="value gold">PKR <%= (typeof user.total_earnings !== 'undefined' && user.total_earnings !== null) ? Number(user.total_earnings).toFixed(2) : '0.00' %></div>
        </div>
        <div class="summary-item">
            <span class="icon">👥</span>
            <div class="label">Team Earnings</div>
            <div class="value purple">PKR <%= (typeof user.team_earnings !== 'undefined' && user.team_earnings !== null) ? Number(user.team_earnings).toFixed(2) : '0.00' %></div>
        </div>
    </div>

    <div class="referral-box">
        <div class="label">🔗 Your Referral Link</div>
        <div class="link" id="referralLink"><%= baseUrl %>/register?ref=<%= user.referral_code %></div>
        <div class="stats">
            <span>👥 Referrals: <%= typeof referralCount !== 'undefined' ? referralCount : 0 %></span>
            <span class="commission-badge">
                <i class="fas fa-gift"></i> 10% Commission
            </span>
        </div>
        <div class="btn-group">
            <button class="btn copy-btn" onclick="copyReferralLink()">
                <i class="fas fa-copy"></i> Copy Link
            </button>
            <button class="btn share-btn" onclick="shareReferralLink()">
                <i class="fas fa-share-alt"></i> Share
            </button>
            <button class="btn whatsapp-btn" onclick="openWhatsApp()">
                <i class="fab fa-whatsapp"></i> WhatsApp
            </button>
        </div>
    </div>

    <a href="https://wa.me/923001234567" target="_blank" class="whatsapp-box">
        <i class="fab fa-whatsapp"></i>
        <div class="info">
            <div class="title">Contact on WhatsApp</div>
            <div class="sub">24/7 Support Available</div>
        </div>
        <span class="btn">Chat Now</span>
    </a>

</div>

<div class="toast" id="toast">
    <i class="fas fa-check-circle"></i>
    <span id="toastMessage">Link copied!</span>
</div>

<script>
    // ==============================
    // SIDEBAR
    // ==============================
    function openSidebar() {
        document.getElementById('leftSidebar').classList.add('open');
        document.getElementById('overlay').classList.add('show');
        document.body.style.overflow = 'hidden';
    }
    function closeSidebar() {
        document.getElementById('leftSidebar').classList.remove('open');
        document.getElementById('overlay').classList.remove('show');
        document.body.style.overflow = 'auto';
    }
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeSidebar(); });

    // ==============================
    // BUY PLAN
    // ==============================
    function buyPlan(planId, investment, name, button) {
        const btn = button || document.getElementById('buyBtn-' + planId);
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';

        if (confirm(`Purchase ${name} plan for PKR ${investment.toLocaleString()}?`)) {
            fetch('/plan/buy', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ plan_id: planId })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    if (data.redirect) {
                        alert('Insufficient balance. Redirecting to deposit...');
                        window.location.href = data.redirect;
                    } else {
                        alert('Error: ' + data.message);
                        btn.disabled = false;
                        btn.innerHTML = originalHtml;
                    }
                }
            })
            .catch(err => {
                alert('Request failed');
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            });
        } else {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    }

    // ==============================
    // REFRESH BALANCE
    // ==============================
    function refreshBalance() {
        const btn = document.getElementById('refreshBtn');
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
        
        fetch('/api/balance')
            .then(res => res.json())
            .then(data => {
                if (data.success && data.data) {
                    document.getElementById('liveBalance').textContent = 'PKR ' + Number(data.data.balance).toFixed(2);
                }
                btn.innerHTML = '<i class="fas fa-sync-alt"></i>';
            })
            .catch(err => {
                btn.innerHTML = '<i class="fas fa-sync-alt"></i>';
                alert('Failed to refresh balance');
            });
    }

    // ==============================
    // TOAST
    // ==============================
    function showToast(message) {
        const toast = document.getElementById('toast');
        const toastMessage = document.getElementById('toastMessage');
        toastMessage.textContent = message;
        toast.className = 'toast show';
        setTimeout(function() {
            toast.classList.remove('show');
        }, 3000);
    }

    // ==============================
    // REFERRAL
    // ==============================
    function copyReferralLink() {
        const link = document.getElementById('referralLink').textContent;
        if (navigator.clipboard) {
            navigator.clipboard.writeText(link).then(function() {
                showToast('✅ Referral link copied!');
            }).catch(function() {
                fallbackCopy(link);
            });
        } else {
            fallbackCopy(link);
        }
    }

    function fallbackCopy(text) {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.left = '-9999px';
        textArea.style.top = '-9999px';
        document.body.appendChild(textArea);
        textArea.select();
        try {
            document.execCommand('copy');
            showToast('✅ Referral link copied!');
        } catch (err) {
            showToast('❌ Failed to copy link');
        }
        document.body.removeChild(textArea);
    }

    function shareReferralLink() {
        const link = document.getElementById('referralLink').textContent;
        if (navigator.share) {
            navigator.share({
                title: 'Join NovaPay',
                text: 'Join NovaPay and start earning! Use my referral link:',
                url: link
            }).catch(function(err) {
                if (err.name !== 'AbortError') {
                    copyReferralLink();
                }
            });
        } else {
            copyReferralLink();
        }
    }

    function openWhatsApp() {
        const link = document.getElementById('referralLink').textContent;
        const message = encodeURIComponent('Join NovaPay and start earning! Use my referral link: ' + link);
        window.open('https://wa.me/?text=' + message, '_blank');
    }

    // ==============================
    // NEON GLOW LIVE UPDATES
    // ==============================
    async function fetchLiveGlowUpdates() {
        try {
            const response = await fetch('/api/live-updates');
            const data = await response.json();
            
            const container = document.getElementById('liveGlowItems');
            const countBadge = document.getElementById('liveCount');
            
            if (data && data.length > 0) {
                countBadge.textContent = data.length + ' updates';
                
                let html = '';
                const items = [...data, ...data, ...data];
                items.forEach(item => {
                    let colorClass = 'green';
                    let icon = '💰';
                    
                    if (item.type === 'withdraw') {
                        colorClass = 'red';
                        icon = '💸';
                    } else if (item.type === 'earning') {
                        colorClass = 'gold';
                        icon = '⛏️';
                    }
                    
                    const timeAgo = item.timeAgo || getTimeAgo(item.created_at);
                    
                    html += `
                        <div class="glow-item">
                            <span class="icon">${item.icon || icon}</span>
                            <span class="text">
                                <strong>${item.username || 'Anonymous'}</strong>
                                ${item.action || 'transacted'}
                                <span class="highlight ${colorClass}">PKR ${Number(item.amount).toFixed(2)}</span>
                            </span>
                            <span class="time">${timeAgo}</span>
                        </div>
                    `;
                });
                container.innerHTML = html;
            } else {
                countBadge.textContent = 'No updates';
                container.innerHTML = `
                    <div class="glow-item">
                        <span class="icon">📢</span>
                        <span class="text" style="color:#64748b;">No recent activity</span>
                    </div>
                `;
            }
        } catch (err) {
            console.error('Live updates error:', err);
        }
    }

    function getTimeAgo(date) {
        const now = new Date();
        const past = new Date(date);
        const diffMs = now - past;
        const diffMins = Math.floor(diffMs / 60000);
        const diffHours = Math.floor(diffMs / 3600000);
        const diffDays = Math.floor(diffMs / 86400000);
        
        if (diffMins < 1) return 'Just now';
        if (diffMins < 60) return diffMins + 'm ago';
        if (diffHours < 24) return diffHours + 'h ago';
        return diffDays + 'd ago';
    }

    let glowInterval = null;

    function startGlowUpdates() {
        if (glowInterval) clearInterval(glowInterval);
        fetchLiveGlowUpdates();
        glowInterval = setInterval(fetchLiveGlowUpdates, 5000);
    }

    document.addEventListener('DOMContentLoaded', startGlowUpdates);

    document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
            if (glowInterval) {
                clearInterval(glowInterval);
                glowInterval = null;
            }
        } else {
            startGlowUpdates();
        }
    });

    // ==============================
    // PREMIUM FLOATING NOTIFICATION
    // ==============================
    const notifNames = [
        'Ali', 'Ahmed', 'Usman', 'Hamza', 'Bilal', 'Awais', 'Zain', 'Saad',
        'Arslan', 'Umer', 'Talha', 'Fahad', 'Asad', 'Shahzaib', 'Irfan',
        'Noman', 'Yasir', 'Waqas', 'Adnan', 'Sufyan', 'Hassan', 'Rayan',
        'Omar', 'Danish', 'Kamran', 'Shahid', 'Farhan', 'Imran', 'Rehan',
        'Saif', 'Mubashir', 'Nadeem', 'Jawad', 'Sohail', 'Tariq', 'Zahid',
        'Faisal', 'Anas', 'Muneeb', 'Haris', 'Huzaifa', 'Shayan', 'Rafay',
        'Usaid', 'Rohan', 'Daniyal', 'Hamid', 'Rizwan', 'Tanveer', 'Sajid'
    ];

    const notifCities = [
        'Lahore', 'Karachi', 'Islamabad', 'Rawalpindi', 'Faisalabad',
        'Multan', 'Peshawar', 'Sialkot', 'Gujranwala', 'Hyderabad',
        'Bahawalpur', 'Sargodha', 'Bhakkar', 'Mianwali', 'Jhelum',
        'Attock', 'Kasur', 'Sheikhupura', 'Sahiwal', 'Gujrat'
    ];

    const notifAmounts = [100, 150, 200, 250, 300, 350, 500, 650, 800, 1000,
        1200, 1500, 1800, 2000, 2500, 3000, 3500, 4000, 5000, 7000,
        8500, 10000, 12000, 15000, 20000, 25000, 30000, 50000, 75000, 100000
    ];

    const notifTimes = ['Just now', '30 seconds ago', '1 minute ago', '2 minutes ago',
        '3 minutes ago', '5 minutes ago', '8 minutes ago', '12 minutes ago',
        '15 minutes ago', '20 minutes ago', '25 minutes ago', '30 minutes ago'
    ];

    const notifCategories = [
        { id: 'deposit', icon: '⬇️', title: 'Deposit', action: 'deposited' },
        { id: 'withdraw', icon: '⬆️', title: 'Withdraw', action: 'withdrew' },
        { id: 'reward', icon: '🎁', title: 'Daily Reward', action: 'earned' },
        { id: 'profit', icon: '💰', title: 'Profit', action: 'received' },
        { id: 'vip', icon: '👑', title: 'VIP Bonus', action: 'received' },
        { id: 'team', icon: '🏆', title: 'Team Bonus', action: 'received' },
        { id: 'referral', icon: '🤝', title: 'Referral Bonus', action: 'received' },
        { id: 'investment', icon: '⭐', title: 'Investment', action: 'purchased' },
        { id: 'cashback', icon: '🔄', title: 'Cashback', action: 'received' }
    ];

    let notificationQueue = [];
    let isShowing = false;
    let notificationTimer = null;
    let progressTimer = null;
    let currentProgress = 100;
    let lastCategory = null;
    let lastName = null;
    let lastCity = null;
    let lastAmount = null;

    function generateNotification() {
        let category;
        let attempts = 0;
        do {
            category = notifCategories[Math.floor(Math.random() * notifCategories.length)];
            attempts++;
        } while (category.id === lastCategory && attempts < 20);
        lastCategory = category.id;

        let name;
        attempts = 0;
        do {
            name = notifNames[Math.floor(Math.random() * notifNames.length)];
            attempts++;
        } while (name === lastName && attempts < 20);
        lastName = name;

        let city;
        attempts = 0;
        do {
            city = notifCities[Math.floor(Math.random() * notifCities.length)];
            attempts++;
        } while (city === lastCity && attempts < 20);
        lastCity = city;

        let amount;
        attempts = 0;
        do {
            amount = notifAmounts[Math.floor(Math.random() * notifAmounts.length)];
            attempts++;
        } while (amount === lastAmount && attempts < 20);
        lastAmount = amount;

        const time = notifTimes[Math.floor(Math.random() * notifTimes.length)];

        let amountText = `PKR ${amount.toLocaleString()}`;
        if (category.id === 'vip') {
            amountText = `VIP Bonus PKR ${amount.toLocaleString()}`;
        } else if (category.id === 'team') {
            amountText = `Team Bonus PKR ${amount.toLocaleString()}`;
        } else if (category.id === 'referral') {
            amountText = `Referral PKR ${amount.toLocaleString()}`;
        } else if (category.id === 'investment') {
            amountText = `VIP Plan PKR ${amount.toLocaleString()}`;
        } else if (category.id === 'reward') {
            amountText = `Daily Reward PKR ${amount.toLocaleString()}`;
        } else if (category.id === 'cashback') {
            amountText = `Cashback PKR ${amount.toLocaleString()}`;
        } else if (category.id === 'profit') {
            amountText = `Profit PKR ${amount.toLocaleString()}`;
        }

        return {
            icon: category.icon,
            title: category.title,
            action: category.action,
            name: name,
            city: city,
            amount: amount,
            amountText: amountText,
            time: time,
            category: category.id
        };
    }

    function showNotification(notification) {
        const card = document.getElementById('notification-card');
        document.getElementById('notifIcon').textContent = notification.icon;
        document.getElementById('notifTitle').textContent = notification.title;
        document.getElementById('notifName').textContent = notification.name;
        document.getElementById('notifAction').textContent = notification.action;
        document.getElementById('notifAmount').textContent = notification.amountText;
        document.getElementById('notifTime').textContent = notification.time;
        document.getElementById('notifLocation').textContent = `📍 ${notification.city}`;

        currentProgress = 100;
        document.getElementById('notifProgress').style.width = '100%';

        card.classList.remove('notification-hidden');
        card.classList.add('notification-show');
        isShowing = true;

        const duration = 4000;
        const interval = 50;
        const step = (interval / duration) * 100;

        progressTimer = setInterval(() => {
            currentProgress -= step;
            if (currentProgress <= 0) {
                currentProgress = 0;
                document.getElementById('notifProgress').style.width = '0%';
                clearInterval(progressTimer);
                hideNotification();
            } else {
                document.getElementById('notifProgress').style.width = currentProgress + '%';
            }
        }, interval);

        notificationTimer = setTimeout(() => {
            hideNotification();
        }, duration);
    }

    function hideNotification() {
        const card = document.getElementById('notification-card');
        card.classList.remove('notification-show');
        card.classList.add('notification-hidden');
        isShowing = false;

        clearTimeout(notificationTimer);
        clearInterval(progressTimer);

        const delay = 3000 + Math.random() * 7000;
        setTimeout(() => {
            if (!isShowing) {
                showNextNotification();
            }
        }, delay);
    }

    function closeNotification() {
        clearTimeout(notificationTimer);
        clearInterval(progressTimer);
        hideNotification();
    }

    function showNextNotification() {
        if (isShowing) return;

        let notification;
        if (notificationQueue.length > 0) {
            notification = notificationQueue.shift();
        } else {
            notification = generateNotification();
            for (let i = 0; i < 5; i++) {
                notificationQueue.push(generateNotification());
            }
        }

        showNotification(notification);
    }

    function initNotificationSystem() {
        for (let i = 0; i < 10; i++) {
            notificationQueue.push(generateNotification());
        }

        setTimeout(() => {
            showNextNotification();
        }, 2000);

        setInterval(() => {
            while (notificationQueue.length < 8) {
                notificationQueue.push(generateNotification());
            }
        }, 10000);
    }

    document.addEventListener('DOMContentLoaded', initNotificationSystem);
</script>

</body>
</html>