<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NovaPay - Admin Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }
        body { background: #0b0e14; color: #e8edf5; padding: 16px; }
        .admin-container { max-width: 1200px; margin: 0 auto; }
        .header { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-bottom: 1px solid #1e293b; margin-bottom: 24px; flex-wrap: wrap; gap: 12px; }
        .logo { font-size: 24px; font-weight: 800; }
        .logo span { color: #3b82f6; }
        .logo small { display: block; font-size: 10px; font-weight: 400; color: #94a3b8; letter-spacing: 2px; }
        .header-actions { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
        .btn { padding: 8px 16px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer; transition: 0.3s; text-decoration: none; display: inline-block; font-size: 13px; }
        .btn-primary { background: #3b82f6; color: white; }
        .btn-primary:hover { background: #2563eb; }
        .btn-danger { background: #b91c1c; color: white; }
        .btn-danger:hover { background: #991b1b; }
        .btn-success { background: #059669; color: white; }
        .btn-success:hover { background: #047857; }
        .btn-outline { background: transparent; border: 1px solid #3b4a60; color: #e8edf5; }
        .btn-outline:hover { background: #1e2a3a; }
        .btn-warning { background: #d97706; color: white; }
        .btn-warning:hover { background: #b45309; }
        .btn-sm { padding: 4px 12px; font-size: 12px; }
        .btn-info { background: #2563eb; color: white; }
        .btn-info:hover { background: #1d4ed8; }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 24px; }
        .stat-card { background: #131a26; border-radius: 12px; padding: 16px; border: 1px solid #1e293b; text-align: center; }
        .stat-card .number { font-size: 24px; font-weight: 700; color: #fbbf24; }
        .stat-card .label { font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; }
        .stat-card .number.green { color: #34d399; }
        .stat-card .number.blue { color: #60a5fa; }
        .stat-card .number.purple { color: #a78bfa; }
        .stat-card .number.red { color: #f87171; }
        .stat-card .number.gold { color: #fbbf24; }
        .section { background: #131a26; border-radius: 16px; padding: 20px; border: 1px solid #1e293b; margin-bottom: 20px; }
        .section h3 { font-size: 16px; margin-bottom: 16px; color: #f1f5f9; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th, td { padding: 10px 8px; text-align: left; border-bottom: 1px solid #1e293b; }
        th { color: #94a3b8; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; }
        td { color: #e8edf5; }
        .badge-status { padding: 2px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; display: inline-block; }
        .badge-pending { background: #92400e; color: #fbbf24; }
        .badge-approved { background: #065f46; color: #34d399; }
        .badge-rejected { background: #7f1d1d; color: #f87171; }
        .badge-active { background: #065f46; color: #34d399; }
        .badge-suspended { background: #7f1d1d; color: #f87171; }
        .badge-inactive { background: #7f1d1d; color: #f87171; }
        .tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
        .tab-btn { padding: 8px 16px; border: 1px solid #1e293b; border-radius: 8px; background: transparent; color: #94a3b8; cursor: pointer; transition: 0.3s; font-size: 13px; }
        .tab-btn.active { background: #3b82f6; color: white; border-color: #3b82f6; }
        .tab-btn:hover:not(.active) { background: #1e293b; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .form-inline { display: flex; gap: 10px; flex-wrap: wrap; align-items: end; }
        .form-inline .form-group { flex: 1; min-width: 120px; }
        .form-inline label { display: block; font-size: 11px; color: #94a3b8; margin-bottom: 2px; }
        .form-inline input, .form-inline select { width: 100%; padding: 6px 10px; border: 1px solid #1e293b; border-radius: 6px; background: #0f172a; color: #e8edf5; font-size: 13px; }
        .form-inline input:focus, .form-inline select:focus { outline: none; border-color: #3b82f6; }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 12px; }
        @media (max-width: 700px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } .header { flex-direction: column; align-items: flex-start; } .grid-2 { grid-template-columns: 1fr; } }
        @media (max-width: 480px) { .stats-grid { grid-template-columns: 1fr 1fr; } .stat-card .number { font-size: 18px; } table { font-size: 11px; } th, td { padding: 6px 4px; } }
    </style>
</head>
<body>
    <div class="admin-container">
        <div class="header">
            <div class="logo">NOVA<span>PAY</span><small>✦ ADMIN PANEL</small></div>
            <div class="header-actions">
                <span style="color:#94a3b8;font-size:13px;">Welcome, Admin</span>
                <a href="/admin/logout" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt"></i> Logout</a>
                <a href="/" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i> User Panel</a>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card"><div class="number"><%= typeof stats !== 'undefined' && stats.total_users ? stats.total_users : 0 %></div><div class="label">Total Users</div></div>
            <div class="stat-card"><div class="number green"><%= typeof stats !== 'undefined' && stats.active_users ? stats.active_users : 0 %></div><div class="label">Active Users</div></div>
            <div class="stat-card"><div class="number blue"><%= typeof stats !== 'undefined' && stats.total_deposits ? Number(stats.total_deposits).toFixed(2) : '0.00' %></div><div class="label">Total Deposits (PKR)</div></div>
            <div class="stat-card"><div class="number purple"><%= typeof stats !== 'undefined' && stats.total_withdraws ? Number(stats.total_withdraws).toFixed(2) : '0.00' %></div><div class="label">Total Withdraws (PKR)</div></div>
            <div class="stat-card"><div class="number red"><%= typeof stats !== 'undefined' && stats.pending_deposits ? stats.pending_deposits : 0 %></div><div class="label">Pending Deposits</div></div>
            <div class="stat-card"><div class="number red"><%= typeof stats !== 'undefined' && stats.pending_withdraws ? stats.pending_withdraws : 0 %></div><div class="label">Pending Withdraws</div></div>
            <div class="stat-card"><div class="number green"><%= typeof stats !== 'undefined' && stats.total_investments ? Number(stats.total_investments).toFixed(2) : '0.00' %></div><div class="label">Total Investments (PKR)</div></div>
            <div class="stat-card"><div class="number gold"><%= typeof stats !== 'undefined' && stats.total_earnings ? Number(stats.total_earnings).toFixed(2) : '0.00' %></div><div class="label">Total Earnings Paid</div></div>
        </div>

        <div class="section">
            <div class="tabs">
                <button class="tab-btn active" onclick="switchTab('deposits', this)"><i class="fas fa-plus-circle"></i> Deposits</button>
                <button class="tab-btn" onclick="switchTab('withdraws', this)"><i class="fas fa-minus-circle"></i> Withdraws</button>
                <button class="tab-btn" onclick="switchTab('plans', this)"><i class="fas fa-rocket"></i> Plans</button>
                <button class="tab-btn" onclick="switchTab('accounts', this)"><i class="fas fa-university"></i> Accounts</button>
                <button class="tab-btn" onclick="switchTab('support', this)"><i class="fas fa-headset"></i> Support</button>
                <button class="tab-btn" onclick="switchTab('users', this)"><i class="fas fa-users"></i> Users</button>
                <button class="tab-btn" onclick="switchTab('referral', this)"><i class="fas fa-gift"></i> Referral</button>
            </div>

            <!-- Deposits -->
            <div id="tab-deposits" class="tab-content active">
                <h3>Pending Deposits</h3>
                <table>
                    <thead><tr><th>User</th><th>Amount</th><th>Method</th><th>Slip</th><th>Actions</th></tr></thead>
                    <tbody>
                        <% 
                            var pendingDeposits = [];
                            if (typeof recentDeposits !== 'undefined' && recentDeposits) {
                                pendingDeposits = recentDeposits.filter(function(d) { return d.status === 'pending'; });
                            }
                        %>
                        <% if (pendingDeposits.length > 0) { %>
                            <% pendingDeposits.forEach(function(d) { %>
                                <tr>
                                    <td><%= d.username || 'N/A' %></td>
                                    <td>PKR <%= (typeof d.amount !== 'undefined' && d.amount !== null) ? Number(d.amount).toFixed(2) : '0.00' %></td>
                                    <td><%= d.payment_method || 'N/A' %></td>
                                    <td><% if (d.slip_image) { %><a href="<%= d.slip_image %>" target="_blank" style="color:#60a5fa;"><i class="fas fa-image"></i> View</a><% } else { %>N/A<% } %></td>
                                    <td>
                                        <button class="btn btn-success btn-sm" onclick="approveDeposit(<%= d.id %>)"><i class="fas fa-check"></i> Approve</button>
                                        <button class="btn btn-danger btn-sm" onclick="rejectDeposit(<%= d.id %>)"><i class="fas fa-times"></i> Reject</button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="5" style="text-align:center;color:#94a3b8;">No pending deposits</td></tr>
                        <% } %>
                    </tbody>
                </table>
                <h3 style="margin-top:20px;">Recent Deposits</h3>
                <table>
                    <thead><tr><th>User</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead>
                    <tbody>
                        <% var depositList = (typeof recentDeposits !== 'undefined' && recentDeposits) ? recentDeposits.slice(0, 10) : []; %>
                        <% if (depositList.length > 0) { %>
                            <% depositList.forEach(function(d) { %>
                                <tr>
                                    <td><%= d.username || 'N/A' %></td>
                                    <td>PKR <%= (typeof d.amount !== 'undefined' && d.amount !== null) ? Number(d.amount).toFixed(2) : '0.00' %></td>
                                    <td><span class="badge-status badge-<%= d.status || 'pending' %>"><%= d.status || 'pending' %></span></td>
                                    <td><%= d.created_at ? new Date(d.created_at).toLocaleDateString() : 'N/A' %></td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="4" style="text-align:center;color:#94a3b8;">No deposits found</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Withdraws -->
            <div id="tab-withdraws" class="tab-content">
                <h3>Pending Withdraws</h3>
                <table>
                    <thead><tr><th>User</th><th>Amount</th><th>Method</th><th>Account</th><th>Actions</th></tr></thead>
                    <tbody>
                        <% 
                            var pendingWithdraws = [];
                            if (typeof recentWithdraws !== 'undefined' && recentWithdraws) {
                                pendingWithdraws = recentWithdraws.filter(function(w) { return w.status === 'pending'; });
                            }
                        %>
                        <% if (pendingWithdraws.length > 0) { %>
                            <% pendingWithdraws.forEach(function(w) { %>
                                <tr>
                                    <td><%= w.username || 'N/A' %></td>
                                    <td>PKR <%= (typeof w.amount !== 'undefined' && w.amount !== null) ? Number(w.amount).toFixed(2) : '0.00' %></td>
                                    <td><%= w.payment_method || 'N/A' %></td>
                                    <td><%= w.account_holder || 'N/A' %></td>
                                    <td>
                                        <button class="btn btn-success btn-sm" onclick="approveWithdraw(<%= w.id %>)"><i class="fas fa-check"></i> Approve</button>
                                        <button class="btn btn-danger btn-sm" onclick="rejectWithdraw(<%= w.id %>)"><i class="fas fa-times"></i> Reject</button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="5" style="text-align:center;color:#94a3b8;">No pending withdraws</td></tr>
                        <% } %>
                    </tbody>
                </table>
                <h3 style="margin-top:20px;">Recent Withdraws</h3>
                <table>
                    <thead><tr><th>User</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead>
                    <tbody>
                        <% var withdrawList = (typeof recentWithdraws !== 'undefined' && recentWithdraws) ? recentWithdraws.slice(0, 10) : []; %>
                        <% if (withdrawList.length > 0) { %>
                            <% withdrawList.forEach(function(w) { %>
                                <tr>
                                    <td><%= w.username || 'N/A' %></td>
                                    <td>PKR <%= (typeof w.amount !== 'undefined' && w.amount !== null) ? Number(w.amount).toFixed(2) : '0.00' %></td>
                                    <td><span class="badge-status badge-<%= w.status || 'pending' %>"><%= w.status || 'pending' %></span></td>
                                    <td><%= w.created_at ? new Date(w.created_at).toLocaleDateString() : 'N/A' %></td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="4" style="text-align:center;color:#94a3b8;">No withdraws found</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Plans -->
            <div id="tab-plans" class="tab-content">
                <div style="margin-bottom:16px;">
                    <h3>Add New Plan</h3>
                    <form class="form-inline" onsubmit="addPlan(event)">
                        <div class="form-group"><label>Plan Name</label><input type="text" id="planName" required></div>
                        <div class="form-group"><label>Investment (PKR)</label><input type="number" id="planInvestment" step="100" required></div>
                        <div class="form-group"><label>Daily Income (PKR)</label><input type="number" id="planDaily" step="10" required></div>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> Add Plan</button>
                    </form>
                </div>
                <h3>All Plans</h3>
                <table>
                    <thead><tr><th>Name</th><th>Investment</th><th>Daily Income</th><th>Status</th><th>Actions</th></tr></thead>
                    <tbody>
                        <% var planList = (typeof plans !== 'undefined' && plans) ? plans : []; %>
                        <% if (planList.length > 0) { %>
                            <% planList.forEach(function(p) { %>
                                <tr>
                                    <td><%= p.name || 'N/A' %></td>
                                    <td>PKR <%= (typeof p.investment !== 'undefined' && p.investment !== null) ? Number(p.investment).toFixed(2) : '0.00' %></td>
                                    <td>PKR <%= (typeof p.daily_income !== 'undefined' && p.daily_income !== null) ? Number(p.daily_income).toFixed(2) : '0.00' %></td>
                                    <td><span class="badge-status badge-<%= p.status || 'active' %>"><%= p.status || 'active' %></span></td>
                                    <td>
                                        <button class="btn btn-warning btn-sm" onclick="editPlan(<%= p.id %>, '<%= p.name %>', <%= Number(p.investment) %>, <%= Number(p.daily_income) %>, '<%= p.status %>')"><i class="fas fa-edit"></i> Edit</button>
                                        <button class="btn btn-danger btn-sm" onclick="deletePlan(<%= p.id %>)"><i class="fas fa-trash"></i> Delete</button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="5" style="text-align:center;color:#94a3b8;">No plans found</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Accounts -->
            <div id="tab-accounts" class="tab-content">
                <div style="margin-bottom:16px;">
                    <h3>Add Deposit Account</h3>
                    <form class="form-inline" onsubmit="addAccount(event)">
                        <div class="form-group"><label>Method</label><input type="text" id="accMethod" placeholder="EasyPaisa" required></div>
                        <div class="form-group"><label>Account Title</label><input type="text" id="accTitle" required></div>
                        <div class="form-group"><label>Account Number</label><input type="text" id="accNumber" required></div>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> Add Account</button>
                    </form>
                </div>
                <h3>Deposit Accounts</h3>
                <table>
                    <thead><tr><th>Method</th><th>Title</th><th>Number</th><th>Status</th><th>Actions</th></tr></thead>
                    <tbody>
                        <% var accountList = (typeof accounts !== 'undefined' && accounts) ? accounts : []; %>
                        <% if (accountList.length > 0) { %>
                            <% accountList.forEach(function(a) { %>
                                <tr>
                                    <td><%= a.method || 'N/A' %></td>
                                    <td><%= a.account_title || 'N/A' %></td>
                                    <td><%= a.account_number || 'N/A' %></td>
                                    <td><span class="badge-status badge-<%= a.status || 'active' %>"><%= a.status || 'active' %></span></td>
                                    <td>
                                        <button class="btn btn-warning btn-sm" onclick="editAccount(<%= a.id %>, '<%= a.method %>', '<%= a.account_title %>', '<%= a.account_number %>', '<%= a.status %>')"><i class="fas fa-edit"></i> Edit</button>
                                        <button class="btn btn-danger btn-sm" onclick="deleteAccount(<%= a.id %>)"><i class="fas fa-trash"></i> Delete</button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="5" style="text-align:center;color:#94a3b8;">No accounts found</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Support -->
            <div id="tab-support" class="tab-content">
                <h3>Support/Contact Settings</h3>
                <form onsubmit="updateSupport(event)" style="max-width:500px;">
                    <div class="form-group" style="margin-bottom:12px;">
                        <label>WhatsApp Channel Link</label>
                        <input type="text" id="supportWhatsapp" value="<%= typeof supportSettings !== 'undefined' && supportSettings.whatsapp_channel ? supportSettings.whatsapp_channel : '' %>" style="width:100%;padding:8px;border:1px solid #1e293b;border-radius:6px;background:#0f172a;color:#e8edf5;">
                    </div>
                    <div class="form-group" style="margin-bottom:12px;">
                        <label>WhatsApp Number</label>
                        <input type="text" id="supportNumber" value="<%= typeof supportSettings !== 'undefined' && supportSettings.whatsapp_number ? supportSettings.whatsapp_number : '' %>" style="width:100%;padding:8px;border:1px solid #1e293b;border-radius:6px;background:#0f172a;color:#e8edf5;">
                    </div>
                    <div class="form-group" style="margin-bottom:12px;">
                        <label>Email</label>
                        <input type="email" id="supportEmail" value="<%= typeof supportSettings !== 'undefined' && supportSettings.email ? supportSettings.email : '' %>" style="width:100%;padding:8px;border:1px solid #1e293b;border-radius:6px;background:#0f172a;color:#e8edf5;">
                    </div>
                    <div class="form-group" style="margin-bottom:12px;">
                        <label>Phone</label>
                        <input type="text" id="supportPhone" value="<%= typeof supportSettings !== 'undefined' && supportSettings.phone ? supportSettings.phone : '' %>" style="width:100%;padding:8px;border:1px solid #1e293b;border-radius:6px;background:#0f172a;color:#e8edf5;">
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Update Settings</button>
                </form>
            </div>

            <!-- Users -->
            <div id="tab-users" class="tab-content">
                <h3>User Management</h3>
                <table>
                    <thead><tr><th>Username</th><th>Mobile</th><th>Balance</th><th>Status</th><th>Actions</th></tr></thead>
                    <tbody id="usersTable"><tr><td colspan="5" style="text-align:center;color:#94a3b8;"><i class="fas fa-spinner fa-spin"></i> Loading users...</td></tr></tbody>
                </table>
                <div class="grid-2">
                    <div>
                        <h4>Give Bonus</h4>
                        <form class="form-inline" onsubmit="giveBonus(event)" style="flex-direction:column;align-items:stretch;">
                            <div class="form-group"><label>User ID</label><input type="number" id="bonusUserId" required></div>
                            <div class="form-group"><label>Amount (PKR)</label><input type="number" id="bonusAmount" step="100" required></div>
                            <div class="form-group"><label>Reason</label><input type="text" id="bonusReason" placeholder="Bonus reason"></div>
                            <button type="submit" class="btn btn-primary"><i class="fas fa-gift"></i> Give Bonus</button>
                        </form>
                    </div>
                    <div>
                        <h4>Adjust Balance</h4>
                        <form class="form-inline" onsubmit="adjustBalance(event)" style="flex-direction:column;align-items:stretch;">
                            <div class="form-group"><label>User ID</label><input type="number" id="balanceUserId" required></div>
                            <div class="form-group"><label>Amount (PKR)</label><input type="number" id="balanceAmount" step="100" required></div>
                            <div class="form-group">
                                <label>Action</label>
                                <select id="balanceAction">
                                    <option value="add">Add</option>
                                    <option value="subtract">Subtract</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-warning"><i class="fas fa-edit"></i> Update Balance</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Referral -->
            <div id="tab-referral" class="tab-content">
                <h3>Referral Settings</h3>
                <form onsubmit="updateReferral(event)" style="max-width:400px;">
                    <div class="form-group" style="margin-bottom:12px;">
                        <label>Commission Percentage (%)</label>
                        <input type="number" id="referralCommission" value="<%= typeof referralSettings !== 'undefined' && referralSettings.commission_percentage ? referralSettings.commission_percentage : 10 %>" step="0.5" min="0" max="100" style="width:100%;padding:8px;border:1px solid #1e293b;border-radius:6px;background:#0f172a;color:#e8edf5;">
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Update Referral Settings</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        function switchTab(tab, btn) {
            document.querySelectorAll('.tab-content').forEach(function(el) { el.classList.remove('active'); });
            document.querySelectorAll('.tab-btn').forEach(function(el) { el.classList.remove('active'); });
            var target = document.getElementById('tab-' + tab);
            if (target) target.classList.add('active');
            if (btn) btn.classList.add('active');
        }

        function approveDeposit(id) {
            if (confirm('Approve this deposit?')) {
                fetch('/admin/deposit/approve', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ deposit_id: id }) })
                .then(function(r) { return r.json(); })
                .then(function(data) { alert(data.message); location.reload(); })
                .catch(function(err) { alert('Error: ' + err); });
            }
        }

        function rejectDeposit(id) {
            if (confirm('Reject this deposit?')) {
                fetch('/admin/deposit/reject', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ deposit_id: id }) })
                .then(function(r) { return r.json(); })
                .then(function(data) { alert(data.message); location.reload(); })
                .catch(function(err) { alert('Error: ' + err); });
            }
        }

        function approveWithdraw(id) {
            if (confirm('Approve this withdraw?')) {
