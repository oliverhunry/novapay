        fetch('/admin/users')
            .then(function(r) { return r.json(); })
            .then(function(users) {
                var tbody = document.getElementById('usersTable');
                if (users && users.length > 0) {
                    var html = '';
                    users.forEach(function(u) {
                        html += '<tr><td>' + (u.username || 'N/A') + '</td><td>' + (u.mobile || 'N/A') + '</td><td>PKR ' + (u.balance ? Number(u.balance).toFixed(2) : '0.00') + '</td><td><span class="badge-status badge-' + (u.status || 'active') + '">' + (u.status || 'active') + '</span></td><td><button class="btn btn-sm btn-info" onclick="viewUser(' + u.id + ')"><i class="fas fa-eye"></i> View</button> <button class="btn btn-sm ' + (u.status === 'active' ? 'btn-danger' : 'btn-success') + '" onclick="toggleUser(' + u.id + ', \'' + (u.status === 'active' ? 'suspended' : 'active') + '\')">' + (u.status === 'active' ? '<i class="fas fa-ban"></i> Suspend' : '<i class="fas fa-check"></i> Activate') + '</button></td></tr>';
                    });
                    tbody.innerHTML = html;
                } else {
                    tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:#94a3b8;">No users found</td></tr>';
                }
            })
            .catch(function(err) {
                document.getElementById('usersTable').innerHTML = '<tr><td colspan="5" style="text-align:center;color:#f87171;">Error loading users</td></tr>';
            });

        function viewUser(id) {
            fetch('/admin/user/' + id)
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.success) {
                        var msg = '👤 User: ' + data.user.username + '\n';
                        msg += '📱 Mobile: ' + data.user.mobile + '\n';
                        msg += '💰 Balance: PKR ' + (data.user.balance ? Number(data.user.balance).toFixed(2) : '0.00') + '\n';
                        msg += '📊 Status: ' + data.user.status + '\n';
                        msg += '📥 Total Deposit: PKR ' + (data.user.total_deposit ? Number(data.user.total_deposit).toFixed(2) : '0.00') + '\n';
                        msg += '📤 Total Withdraw: PKR ' + (data.user.total_withdraw ? Number(data.user.total_withdraw).toFixed(2) : '0.00') + '\n';
                        msg += '📈 Total Earnings: PKR ' + (data.user.total_earnings ? Number(data.user.total_earnings).toFixed(2) : '0.00') + '\n';
                        msg += '👥 Team Earnings: PKR ' + (data.user.team_earnings ? Number(data.user.team_earnings).toFixed(2) : '0.00') + '\n';
                        msg += '🎁 Bonus: PKR ' + (data.user.bonus_balance ? Number(data.user.bonus_balance).toFixed(2) : '0.00') + '\n';
                        msg += '\n📋 Plans: ' + (data.plans ? data.plans.length : 0) + '\n';
                        msg += '💳 Deposits: ' + (data.deposits ? data.deposits.length : 0) + '\n';
                        msg += '💸 Withdraws: ' + (data.withdraws ? data.withdraws.length : 0);
                        alert(msg);
                    } else {
                        alert('User not found');
                    }
                })
                .catch(function(err) { alert('Error loading user'); });
        }

        function toggleUser(id, status) {
            if (confirm('Change user status to ' + status + '?')) {
                fetch('/admin/user/status', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ user_id: id, status: status }) })
                .then(function(r) { return r.json(); })
                .then(function(data) { alert(data.message); location.reload(); })
                .catch(function(err) { alert('Error: ' + err); });
            }
        }
