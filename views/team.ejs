<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NovaPay - Team</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }
        body { background: #f0f4f8; min-height: 100vh; padding: 20px; }
        .container { max-width: 480px; margin: 0 auto; background: white; border-radius: 20px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px solid #eef2f6; }
        .header .logo { font-size: 20px; font-weight: 800; color: #0f172a; }
        .header .logo span { color: #3b82f6; }
        .header a { color: #3b82f6; text-decoration: none; font-size: 14px; }
        
        .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px; }
        .stat-card { background: #f8fafc; border: 1px solid #eef2f6; border-radius: 12px; padding: 14px; text-align: center; }
        .stat-card .number { font-size: 22px; font-weight: 700; color: #0f172a; }
        .stat-card .number.green { color: #22c55e; }
        .stat-card .number.blue { color: #3b82f6; }
        .stat-card .number.purple { color: #8b5cf6; }
        .stat-card .number.gold { color: #f59e0b; }
        .stat-card .label { font-size: 10px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; }
        
        .section-title { font-size: 14px; font-weight: 600; color: #0f172a; margin: 16px 0 10px; }
        .section-title small { font-size: 10px; font-weight: 400; color: #94a3b8; display: block; }
        
        .team-member { background: #f8fafc; border: 1px solid #eef2f6; border-radius: 10px; padding: 10px 14px; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; }
        .team-member .info .name { font-weight: 600; font-size: 13px; color: #0f172a; }
        .team-member .info .date { font-size: 10px; color: #94a3b8; }
        .team-member .badge { background: #22c55e; color: white; font-size: 9px; padding: 2px 10px; border-radius: 12px; }
        .team-member .badge.inactive { background: #94a3b8; }
        
        .commission-item { background: #f8fafc; border: 1px solid #eef2f6; border-radius: 10px; padding: 10px 14px; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; }
        .commission-item .info .text { font-size: 13px; color: #0f172a; }
        .commission-item .info .date { font-size: 10px; color: #94a3b8; }
        .commission-item .amount { font-weight: 700; color: #22c55e; }
        
        .no-data { text-align: center; padding: 30px 20px; color: #94a3b8; }
        .no-data i { font-size: 40px; display: block; margin-bottom: 10px; }
        
        /* ============================== */
        /* REFERRAL BOX - HIGHLIGHTED */
        /* ============================== */
        .referral-link-box {
            background: linear-gradient(135deg, #f8fafc, #eff6ff);
            border: 2px solid #3b82f6;
            border-radius: 12px;
            padding: 16px 18px;
            margin-bottom: 16px;
            position: relative;
        }
        .referral-link-box .label {
            font-size: 11px;
            color: #3b82f6;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 700;
        }
        .referral-link-box .link {
            color: #1d4ed8;
            word-break: break-all;
            font-size: 13px;
            margin-top: 4px;
            font-weight: 600;
        }
        .referral-link-box .commission-badge {
            display: inline-block;
            background: linear-gradient(135deg, #22c55e, #16a34a);
            color: white;
            font-size: 13px;
            font-weight: 700;
            padding: 4px 16px;
            border-radius: 20px;
            margin-top: 6px;
        }
        .referral-link-box .commission-badge i {
            margin-right: 4px;
        }
        .referral-link-box .btn-group {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 10px;
        }
        .referral-link-box .btn-group .btn {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 6px 16px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
            color: #475569;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .referral-link-box .btn-group .btn:hover {
            background: #3b82f6;
            color: white;
            border-color: #3b82f6;
            transform: scale(1.02);
        }
        .referral-link-box .btn-group .btn i {
            font-size: 14px;
        }
        .referral-link-box .btn-group .btn.share-btn {
            background: #25D366;
            color: white;
            border-color: #25D366;
        }
        .referral-link-box .btn-group .btn.share-btn:hover {
            background: #1da851;
            border-color: #1da851;
        }
        .referral-link-box .btn-group .btn.copy-btn {
            background: #3b82f6;
            color: white;
            border-color: #3b82f6;
        }
        .referral-link-box .btn-group .btn.copy-btn:hover {
            background: #2563eb;
            border-color: #2563eb;
        }
        
        .flash-message { padding: 10px 14px; border-radius: 10px; margin-bottom: 12px; font-size: 13px; }
        .flash-success { background: #dcfce7; color: #166534; border: 1px solid #86efac; }
        .flash-error { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
        
        /* Toast notification */
        .toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background: #0f172a;
            color: white;
            padding: 12px 24px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 600;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            display: none;
            z-index: 9999;
            animation: slideUp 0.4s ease;
        }
        .toast.show { display: block; }
        .toast i { margin-right: 8px; }
        .toast.success i { color: #22c55e; }
        @keyframes slideUp {
            0% { opacity: 0; transform: translateX(-50%) translateY(20px); }
            100% { opacity: 1; transform: translateX(-50%) translateY(0); }
        }
        @media (max-width: 480px) {
            .referral-link-box .btn-group .btn { font-size: 11px; padding: 5px 12px; }
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <div class="logo">👥 NOVA<span>PAY</span></div>
        <a href="/dashboard"><i class="fas fa-arrow-left"></i> Back</a>
    </div>

    <!-- Toast Notification -->
    <div class="toast" id="toast">
        <i class="fas fa-check-circle"></i>
        <span id="toastMessage">Link copied!</span>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="flash-message flash-success"><%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="flash-message flash-error"><%= error %></div>
    <% } %>

    <!-- Stats Grid -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="number blue"><%= typeof referrals !== 'undefined' ? referrals.length : 0 %></div>
            <div class="label">Total Team Members</div>
        </div>
        <div class="stat-card">
            <div class="number green"><%= typeof activeMembers !== 'undefined' ? activeMembers : 0 %></div>
            <div class="label">Active Members</div>
        </div>
        <div class="stat-card">
            <div class="number gold"><%= typeof totalTeamDeposit !== 'undefined' ? totalTeamDeposit.toFixed(2) : '0.00' %></div>
            <div class="label">Team Deposit (PKR)</div>
        </div>
        <div class="stat-card">
            <div class="number purple"><%= user.team_earnings ? user.team_earnings.toFixed(2) : '0.00' %></div>
            <div class="label">Referral Earnings</div>
        </div>
    </div>

    <!-- ============================== -->
    <!-- REFERRAL LINK BOX - HIGHLIGHTED -->
    <!-- ============================== -->
    <div class="referral-link-box">
        <div class="label">🔗 Your Referral Link</div>
        <div class="link" id="referralLink"><%= baseUrl %>/register?ref=<%= user.referral_code %></div>
        
        <div style="margin-top:8px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
            <span class="commission-badge">
                <i class="fas fa-gift"></i> 10% Commission
            </span>
            <span style="font-size:12px;color:#64748b;">
                <i class="fas fa-info-circle"></i> Earn on every deposit
            </span>
        </div>

        <div class="btn-group">
            <button class="btn copy-btn" onclick="copyReferralLink()">
                <i class="fas fa-copy"></i> Copy Link
            </button>
            <button class="btn share-btn" onclick="shareReferralLink()">
                <i class="fas fa-share-alt"></i> Share
            </button>
            <button class="btn" onclick="openWhatsApp()" style="background:#25D366;color:white;border-color:#25D366;">
                <i class="fab fa-whatsapp"></i> WhatsApp
            </button>
        </div>
    </div>

    <!-- ============================== -->
    <!-- REFERRAL HISTORY -->
    <!-- ============================== -->
    <div class="section-title">
        Referral History
        <small>COMMISSIONS EARNED</small>
    </div>
    <% if (typeof referralHistory !== 'undefined' && referralHistory && referralHistory.length > 0) { %>
        <% referralHistory.forEach(function(hist) { %>
            <div class="commission-item">
                <div class="info">
                    <div class="text">💰 Commission from deposit</div>
                    <div class="date"><%= hist.created_at ? new Date(hist.created_at).toLocaleDateString() : 'N/A' %></div>
                </div>
                <div class="amount">+PKR <%= hist.commission ? hist.commission.toFixed(2) : '0.00' %></div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="no-data">
            <i class="fas fa-handshake"></i>
            <p>No commissions earned yet</p>
            <p style="font-size:12px;">Share your referral link to start earning!</p>
        </div>
    <% } %>

    <!-- ============================== -->
    <!-- TEAM MEMBERS -->
    <!-- ============================== -->
    <div class="section-title">
        Team Members
        <small>YOUR REFERRALS</small>
    </div>
    <% if (typeof referrals !== 'undefined' && referrals && referrals.length > 0) { %>
        <% referrals.forEach(function(ref) { %>
            <div class="team-member">
                <div class="info">
                    <div class="name"><%= ref.username %></div>
                    <div class="date">Joined: <%= ref.created_at ? new Date(ref.created_at).toLocaleDateString() : 'N/A' %></div>
                </div>
                <span class="badge <%= ref.status === 'active' ? '' : 'inactive' %>">
                    <i class="fas <%= ref.status === 'active' ? 'fa-check-circle' : 'fa-clock' %>"></i>
                    <%= ref.status === 'active' ? 'Active' : 'Inactive' %>
                </span>
            </div>
        <% }); %>
    <% } else { %>
        <div class="no-data">
            <i class="fas fa-users"></i>
            <p>No team members yet</p>
            <p style="font-size:12px;">Share your referral link to grow your team!</p>
        </div>
    <% } %>
</div>

<!-- ============================== -->
<!-- SCRIPTS -->
<!-- ============================== -->
<script>
    function showToast(message, type) {
        const toast = document.getElementById('toast');
        const toastMessage = document.getElementById('toastMessage');
        toastMessage.textContent = message;
        toast.className = 'toast show ' + (type || 'success');
        setTimeout(function() {
            toast.classList.remove('show');
        }, 3000);
    }

    function copyReferralLink() {
        const link = document.getElementById('referralLink').textContent;
        
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(link).then(function() {
                showToast('✅ Referral link copied!', 'success');
            }).catch(function() {
                fallbackCopy(link);
            });
        } else {
            fallbackCopy(link);
        }
    }

    function fallbackCopy(text) {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.left = '-9999px';
        textArea.style.top = '-9999px';
        document.body.appendChild(textArea);
        textArea.select();
        try {
            document.execCommand('copy');
            showToast('✅ Referral link copied!', 'success');
        } catch (err) {
            showToast('❌ Failed to copy link', 'error');
        }
        document.body.removeChild(textArea);
    }

    function shareReferralLink() {
        const link = document.getElementById('referralLink').textContent;
        
        if (navigator.share) {
            navigator.share({
                title: 'Join NovaPay',
                text: 'Join NovaPay and start earning! Use my referral link:',
                url: link
            }).catch(function(err) {
                if (err.name !== 'AbortError') {
                    copyReferralLink();
                }
            });
        } else {
            copyReferralLink();
        }
    }

    function openWhatsApp() {
        const link = document.getElementById('referralLink').textContent;
        const message = encodeURIComponent('Join NovaPay and start earning! Use my referral link: ' + link);
        window.open('https://wa.me/?text=' + message, '_blank');
    }
</script>

</body>
</html>