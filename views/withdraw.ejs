<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NovaPay - Withdraw</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }
        body { background: #f0f4f8; min-height: 100vh; padding: 20px; }
        .container { max-width: 480px; margin: 0 auto; background: white; border-radius: 20px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px solid #eef2f6; }
        .header .logo { font-size: 20px; font-weight: 800; color: #0f172a; }
        .header .logo span { color: #3b82f6; }
        .header a { color: #3b82f6; text-decoration: none; font-size: 14px; transition: color 0.3s; }
        .header a:hover { color: #2563eb; text-decoration: underline; }
        .balance-box { background: linear-gradient(135deg, #1e293b, #0f172a); border-radius: 12px; padding: 15px 20px; margin-bottom: 20px; text-align: center; color: white; }
        .balance-box .label { font-size: 11px; color: #94a3b8; text-transform: uppercase; }
        .balance-box .amount { font-size: 24px; font-weight: 700; }
        .form-group { margin-bottom: 14px; }
        .form-group label { display: block; font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 4px; }
        .form-group label i { margin-right: 4px; color: #3b82f6; }
        .form-group input, .form-group select { 
            width: 100%; 
            padding: 10px 14px; 
            border: 1px solid #e2e8f0; 
            border-radius: 10px; 
            font-size: 14px; 
            transition: border-color 0.3s, box-shadow 0.3s;
        }
        .form-group input:focus, .form-group select:focus { 
            outline: none; 
            border-color: #3b82f6; 
            box-shadow: 0 0 0 3px rgba(59,130,246,0.1); 
        }
        .btn-submit { 
            width: 100%; 
            padding: 12px; 
            background: #3b82f6; 
            color: white; 
            border: none; 
            border-radius: 10px; 
            font-size: 16px; 
            font-weight: 600; 
            cursor: pointer; 
            transition: background 0.3s, transform 0.2s;
        }
        .btn-submit:hover { background: #2563eb; }
        .btn-submit:active { transform: scale(0.98); }
        .btn-submit:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none !important;
        }
        .flash-message { padding: 10px 14px; border-radius: 10px; margin-bottom: 12px; font-size: 13px; }
        .flash-success { background: #dcfce7; color: #166534; border: 1px solid #86efac; }
        .flash-error { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
        .info-box { 
            background: linear-gradient(135deg, #f8fafc, #eff6ff); 
            border: 1px solid #3b82f6; 
            border-radius: 10px; 
            padding: 12px 16px; 
            margin-bottom: 16px; 
        }
        .info-box .title { font-weight: 600; font-size: 13px; color: #0f172a; margin-bottom: 4px; }
        .info-box .title i { color: #3b82f6; margin-right: 4px; }
        .info-box .detail { font-size: 12px; color: #64748b; padding: 2px 0; }
        .info-box .detail i { margin-right: 6px; color: #22c55e; }
        .min-amount-warning {
            background: #fef3c7;
            border: 1px solid #f59e0b;
            border-radius: 8px;
            padding: 8px 12px;
            margin-bottom: 16px;
            font-size: 12px;
            color: #92400e;
            text-align: center;
        }
        .min-amount-warning i { margin-right: 6px; color: #f59e0b; }
        .max-amount-hint {
            font-size: 11px;
            color: #94a3b8;
            margin-top: 4px;
        }
        .max-amount-hint span { 
            color: #3b82f6; 
            font-weight: 600; 
        }
        .spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255,255,255,0.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spin 0.6s linear infinite;
            margin-right: 6px;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        @media (max-width: 480px) {
            .container { padding: 16px; }
            .balance-box .amount { font-size: 20px; }
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <div class="logo">💸 NOVA<span>PAY</span></div>
        <a href="/dashboard"><i class="fas fa-arrow-left"></i> Back</a>
    </div>

    <div class="balance-box">
        <div class="label">💰 Your Balance</div>
        <div class="amount" id="withdrawBalance">PKR <%= (typeof user.balance !== 'undefined' && user.balance !== null) ? Number(user.balance).toFixed(2) : '0.00' %></div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="flash-message flash-success"><%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="flash-message flash-error"><%= error %></div>
    <% } %>

    <!-- ✅ CHANGED: 130 PKR -->
    <div class="min-amount-warning">
        <i class="fas fa-info-circle"></i> Minimum withdraw: PKR 130
    </div>

    <div class="info-box">
        <div class="title"><i class="fas fa-clock"></i> Withdraw Instructions</div>
        <div class="detail"><i class="fas fa-check-circle"></i> Minimum withdraw: PKR 130</div>
        <div class="detail"><i class="fas fa-clock"></i> Processing time: 30 minutes</div>
        <div class="detail"><i class="fas fa-shield-alt"></i> Secure &amp; Instant processing</div>
    </div>

    <form action="/withdraw" method="POST" id="withdrawForm">
        <div class="form-group">
            <label><i class="fas fa-coins"></i> Amount (PKR)</label>
            <input type="number" name="amount" id="withdrawAmount" min="130" step="10" required placeholder="Enter amount">
            <div class="max-amount-hint">
                Max: <span id="maxAmountDisplay">PKR <%= (typeof user.balance !== 'undefined' && user.balance !== null) ? Number(user.balance).toFixed(2) : '0.00' %></span>
            </div>
        </div>
        <div class="form-group">
            <label><i class="fas fa-university"></i> Payment Method</label>
            <select name="payment_method" required>
                <option value="">Select method</option>
                <option value="EasyPaisa">EasyPaisa</option>
                <option value="JazzCash">JazzCash</option>
                <option value="Bank Transfer">Bank Transfer</option>
            </select>
        </div>
        <div class="form-group">
            <label><i class="fas fa-user"></i> Account Holder Name</label>
            <input type="text" name="account_holder" placeholder="Enter account holder name" required>
        </div>
        <div class="form-group">
            <label><i class="fas fa-hashtag"></i> Account Number</label>
            <input type="text" name="account_number" placeholder="Enter account number" required>
        </div>
        <button type="submit" class="btn-submit" id="withdrawBtn">
            <i class="fas fa-paper-plane"></i> Submit Withdraw
        </button>
    </form>
</div>

<script>
    const balanceInput = document.getElementById('withdrawAmount');
    const balanceDisplay = document.getElementById('withdrawBalance');
    const maxAmountDisplay = document.getElementById('maxAmountDisplay');
    const withdrawBtn = document.getElementById('withdrawBtn');
    const withdrawForm = document.getElementById('withdrawForm');
    
    const balanceText = balanceDisplay.textContent.replace('PKR ', '');
    const maxBalance = parseFloat(balanceText) || 0;
    
    balanceInput.setAttribute('max', maxBalance);
    
    const MIN_WITHDRAW = 130;
    
    maxAmountDisplay.textContent = 'PKR ' + maxBalance.toFixed(2);
    
    balanceInput.addEventListener('input', function() {
        const value = parseFloat(this.value);
        if (value > maxBalance) {
            this.value = maxBalance;
            alert('Amount cannot exceed your balance of PKR ' + maxBalance.toFixed(2));
        }
    });
    
    withdrawForm.addEventListener('submit', function(e) {
        const amount = parseFloat(document.getElementById('withdrawAmount').value);
        
        if (!amount || amount < MIN_WITHDRAW) {
            e.preventDefault();
            alert('Minimum withdraw amount is PKR ' + MIN_WITHDRAW.toLocaleString());
            return;
        }
        
        if (amount > maxBalance) {
            e.preventDefault();
            alert('Amount cannot exceed your balance of PKR ' + maxBalance.toFixed(2));
            return;
        }
        
        if (amount % 10 !== 0) {
            e.preventDefault();
            alert('Amount must be in multiples of 10 PKR');
            return;
        }
        
        if (!confirm(`Are you sure you want to withdraw PKR ${amount.toFixed(2)}?`)) {
            e.preventDefault();
            return;
        }
        
        withdrawBtn.disabled = true;
        withdrawBtn.innerHTML = '<span class="spinner"></span> Processing...';
    });

    window.addEventListener('pageshow', function() {
        withdrawBtn.disabled = false;
        withdrawBtn.innerHTML = '<i class="fas fa-paper-plane"></i> Submit Withdraw';
    });

    balanceInput.addEventListener('blur', function() {
        const value = parseFloat(this.value);
        if (value && value < MIN_WITHDRAW) {
            alert('Minimum withdraw amount is PKR ' + MIN_WITHDRAW.toLocaleString());
            this.value = '';
            this.focus();
        }
    });

    balanceInput.addEventListener('focus', function() {
        this.select();
    });
</script>

</body>
</html>