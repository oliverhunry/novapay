<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NovaPay - Bonus</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }
        body { background: #f0f4f8; min-height: 100vh; padding: 20px; }
        .container { max-width: 480px; margin: 0 auto; background: white; border-radius: 20px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px solid #eef2f6; }
        .header .logo { font-size: 20px; font-weight: 800; color: #0f172a; }
        .header .logo span { color: #3b82f6; }
        .header a { color: #3b82f6; text-decoration: none; font-size: 14px; }
        .balance-box { background: linear-gradient(135deg, #1e293b, #0f172a); border-radius: 12px; padding: 15px 20px; margin-bottom: 20px; text-align: center; color: white; }
        .balance-box .label { font-size: 11px; color: #94a3b8; text-transform: uppercase; }
        .balance-box .amount { font-size: 28px; font-weight: 700; }
        .bonus-item { background: #f8fafc; border: 1px solid #eef2f6; border-radius: 10px; padding: 12px 14px; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; }
        .bonus-item .info .reason { font-weight: 600; font-size: 13px; color: #0f172a; }
        .bonus-item .info .date { font-size: 10px; color: #94a3b8; }
        .bonus-item .amount { font-weight: 700; color: #22c55e; }
        .no-data { text-align: center; padding: 30px 20px; color: #94a3b8; }
        .no-data i { font-size: 40px; display: block; margin-bottom: 10px; }
        .flash-message { padding: 10px 14px; border-radius: 10px; margin-bottom: 12px; font-size: 13px; }
        .flash-success { background: #dcfce7; color: #166534; border: 1px solid #86efac; }
        .flash-error { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <div class="logo">🎁 NOVA<span>PAY</span></div>
        <a href="/dashboard"><i class="fas fa-arrow-left"></i> Back</a>
    </div>

    <div class="balance-box">
        <div class="label">💰 Your Balance</div>
        <div class="amount">PKR <%= user.balance ? user.balance.toFixed(2) : '0.00' %></div>
    </div>

    <div class="balance-box" style="background: linear-gradient(135deg, #8b5cf6, #7c3aed);">
        <div class="label">🎁 Bonus Balance</div>
        <div class="amount">PKR <%= user.bonus_balance ? user.bonus_balance.toFixed(2) : '0.00' %></div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="flash-message flash-success"><%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="flash-message flash-error"><%= error %></div>
    <% } %>

    <h3 style="margin-bottom:12px;color:#0f172a;">📋 Bonus History</h3>

    <% if (typeof bonuses !== 'undefined' && bonuses && bonuses.length > 0) { %>
        <% bonuses.forEach(function(bonus) { %>
            <div class="bonus-item">
                <div class="info">
                    <div class="reason"><%= bonus.reason || 'Bonus' %></div>
                    <div class="date"><%= bonus.created_at ? new Date(bonus.created_at).toLocaleDateString() : 'N/A' %></div>
                </div>
                <div class="amount">+PKR <%= bonus.amount ? bonus.amount.toFixed(2) : '0.00' %></div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="no-data">
            <i class="fas fa-gift"></i>
            <p>No bonuses received yet</p>
        </div>
    <% } %>
</div>

</body>
</html>